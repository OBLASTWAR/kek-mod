class Out:
    """Themed plain-terminal output: magenta everywhere, green only for what's
    installed (same as the full-screen UI), plain text when piped or NO_COLOR.
    Every line starts in magenta and colored spans fall back to it, so
    uncolored text is never the terminal's default color."""

    BASE = "1;38;5;199"

    def __init__(self, color):
        self.color = color
        self.tty = sys.stdout.isatty()
        self._bar = False

    def c(self, code, s):
        return "\033[%sm%s\033[0;%sm" % (code, s, self.BASE) if self.color else s

    def g(self, s):
        return self.c("1;38;5;46", s)

    def m(self, s):
        return self.c(self.BASE, s)

    def d(self, s):
        return self.c("38;5;89", s)

    def _emit(self, s, stream=None):
        if self.color:
            s = "\033[%sm%s\033[0m" % (self.BASE, s)
        print(s, file=stream or sys.stdout)

    def _clear_bar(self):
        if self._bar:
            sys.stdout.write("\r\033[K")
            self._bar = False

    def banner(self):
        self._emit("-=[ CIV V MOD INSTALLER ]=-" + self.d("  v%s // linux @OBLAST" % VERSION))

    def section(self, title):
        self._emit("═[ %s ]%s" % (title, "═" * max(3, 50 - len(title))))

    def line(self, s):
        self._clear_bar()
        self._emit(s)

    def log(self, msg):
        self._clear_bar()
        self._emit("  ▸ " + msg)

    def progress(self, pct):
        if not self.tty:
            return
        width = 30
        fill = width * pct // 100
        bar = "  [" + "█" * fill + self.d("░" * (width - fill)) + "] %3d%%" % pct
        sys.stdout.write("\r\033[K" + ("\033[%sm%s\033[0m" % (self.BASE, bar) if self.color else bar))
        sys.stdout.flush()
        self._bar = True

    def done(self):
        self._clear_bar()

    def error(self, msg):
        self._clear_bar()
        self._emit("[!!] " + msg, sys.stderr)

    def check(self, ok, msg):
        self._emit("  " + ("[OK]" if ok else "[!!]") + " " + msg)


class Cli:
    def __init__(self, args, out):
        self.args = args
        self.out = out
        self.settings = Settings()

    # helpers
    def game(self, require=True):
        game = find_game(self.settings, self.args.civ_dir)
        if require:
            if game is None:
                raise InstallerError("Civilization V wasn't found in any Steam library. Pass --civ-dir "
                                     "\".../steamapps/common/%s\" or save it with `settings --civ-dir`." % CIV_FOLDER)
            problem = game.problem()
            if problem:
                raise InstallerError(problem)
        return game

    def confirm(self, question):
        if self.args.yes:
            return True
        if not sys.stdin.isatty():
            raise InstallerError(question + " (re-run with --yes to confirm)")
        ans = input(self.out.m("[??] ") + question + " [y/N] ").strip().lower()
        return ans in ("y", "yes")

    def require_civ_closed(self):
        if is_civ_running():
            raise InstallerError("Civilization V is running. Close it first (or `civ5-mod kill`).")

    def releases(self, mods=MODS):
        out = {}
        for m in mods:
            try:
                out[m.id] = m.source.list_releases()
            except InstallerError:
                pass
        try:
            out[LOBBY_REPO] = lobby_latest_tag()
        except InstallerError:
            pass
        return out

    def run_job(self, fn, *a):
        fn(*a, self.out.log, self.out.progress)
        self.out.done()

    def beta(self):
        return self.args.beta or self.settings.show_beta

    # commands
    def cmd_status(self):
        game = self.game(require=False)
        offline = getattr(self.args, "offline", False)
        releases = {} if offline else self.releases()
        state = State(game, releases, self.settings.show_beta)
        self.out.banner()
        self.out.line(self.out.d(" game   ") + (game.root if game else self.out.m("not found")))
        if game:
            self.out.line(self.out.d(" prefix ") + (game.prefix or self.out.m("none yet -- launch Civ V once under Proton")))
        self.out.section("GAME MODS")
        for mod in MODS:
            v = state.mod_version(mod)
            dot = self.out.g("●") if v else self.out.m("○")
            line = "  %s %s" % (dot, (self.out.g(mod.name) if v else self.out.m(mod.name)))
            if v:
                line += self.out.g("  " + v)
            if mod.id in state.updates:
                line += self.out.g("  » update: " + state.updates[mod.id])
            self.out.line(line)
            if mod.extra:
                ev = state.extras.get(mod.extra.id)
                self.out.line("      %s %s" % (self.out.g("└─ ●") if ev is not None else self.out.m("└─ ○"),
                                                   self.out.g(mod.extra.name + ("  " + ev if ev else "")) if ev is not None
                                                   else self.out.m(mod.extra.name)))
        self.out.section("INTERFACE MODS")
        for v in EUI_VARIANTS:
            active = state.eui == v.id
            if active and state.eui_match is False:
                self.out.line("  %s %s" % (self.out.g("!"), self.out.g(v.name + " -- VERSION MISMATCH")))
            else:
                self.out.line("  %s %s" % (self.out.g("●") if active else self.out.m("○"),
                                           self.out.g(v.label()) if active else self.out.m(v.label())))
        self.out.section("NETWORK MODS")
        if state.lobby is None:
            self.out.line("  %s %s" % (self.out.m("○"), self.out.m(LOBBY_NAME)))
        else:
            line = "  %s %s" % (self.out.g("●"), self.out.g(LOBBY_NAME + ("  " + state.lobby if state.lobby else "")))
            if state.lobby_update:
                line += self.out.g("  » update: " + state.lobby_update)
            self.out.line(line)
        self.out.section("CHECKS")
        checks = run_checks(game, state)
        for ok, msg in checks:
            self.out.check(ok, msg)
        if offline:
            self.out.line(self.out.d("  (offline: update check skipped)"))
        return 0 if all(ok for ok, _ in checks) else 1

    def cmd_versions(self):
        mod = mod_by_name(self.args.mod)
        rels = mod.source.list_releases()
        beta = self.beta()
        game = self.game(require=False)
        current = None
        if game and not game.problem():
            current = State(game, {}, beta).mod_version(mod)
        self.out.section(mod.name.upper() + " VERSIONS")
        latest = latest_release(mod, rels, beta)
        for r in rels:
            if r.prerelease and not beta:
                continue
            tags = []
            if mod.beta_optin:
                tags.append("[beta]" if r.prerelease else "[stable]")
            if r.extra:
                tags.append(r.extra)
            if latest and r.tag == latest.tag:
                tags.append(self.out.m("« latest"))
            if current and r.tag.lower() == current.lower():
                tags.append(self.out.m("« installed"))
            self.out.line("  %-16s %s" % (r.tag, "  ".join(tags)))
        if mod.beta_optin and not beta:
            self.out.line(self.out.d("  (betas hidden -- add --beta or `settings --beta on`)"))
        return 0

    def cmd_install(self):
        mod = mod_by_name(self.args.mod)
        game = self.game()
        self.require_civ_closed()
        state = State(game, {}, self.settings.show_beta)
        if mod is TOURNAMENT and state.eui == "eui_xits":
            if not self.confirm("Tournament Mod and EUI XITS are not compatible. Install anyway?"):
                return 1
        conflicts = [m for m in state.installed_mods() if m is not mod]
        if conflicts:
            names = ", ".join(m.name for m in conflicts)
            if not self.confirm("Installing %s will uninstall %s first -- these mods can't run side by side. "
                                "Continue?" % (mod.name, names)):
                return 1
        self.out.banner()
        for c in conflicts:
            self.out.section("REMOVING " + c.name.upper())
            self.run_job(uninstall_mod, game, c)
        self.out.section("INSTALLING " + mod.name.upper())
        self.run_job(install_mod, game, mod, self.args.version, self.beta())
        return 0

    def cmd_uninstall(self):
        mod = mod_by_name(self.args.mod)
        game = self.game()
        self.require_civ_closed()
        self.out.section("REMOVING " + mod.name.upper())
        self.run_job(uninstall_mod, game, mod)
        return 0

    def cmd_eui(self):
        game = self.game()
        self.require_civ_closed()
        if self.args.action == "install":
            v = eui_by_name(self.args.variant)
            state = State(game, {}, False)
            if v.id == "eui_xits" and TOURNAMENT.id in state.installed:
                if not self.confirm("Tournament Mod and EUI XITS are not compatible. Install anyway?"):
                    return 1
            self.out.section("INSTALLING " + v.name.upper())
            self.run_job(eui_install, game, v)
        else:
            self.out.section("REMOVING EUI")
            self.run_job(eui_remove, game)
        return 0

    def cmd_lobby(self):
        game = self.game()
        self.require_civ_closed()
        if self.args.action == "install":
            self.out.section("INSTALLING " + LOBBY_NAME.upper())
            self.run_job(lobby_install, game)
        else:
            self.out.section("REMOVING " + LOBBY_NAME.upper())
            self.run_job(lobby_remove, game)
        return 0

    def cmd_verify(self):
        game = self.game(require=False)
        state = State(game, self.releases(), self.settings.show_beta)
        self.out.section("CHECKS")
        checks = run_checks(game, state)
        for ok, msg in checks:
            self.out.check(ok, msg)
        extras = scan_extra_folders(game)
        self.out.section("UNRECOGNIZED FOLDERS")
        if not extras:
            self.out.line(self.out.d("  Nothing -- every folder in Assets/DLC and Assets/Maps is accounted for."))
        by_name = {}
        for e in extras:
            by_name.setdefault(e.name.lower(), []).append(e)
            self.out.line("  %s %-40s %s" % (self.out.m("[%s]" % e.where), e.name, self.out.d(format_size(e.size))))
        if extras and not (self.args.archive or self.args.delete):
            self.out.line(self.out.d("  Keep them, or: verify --archive NAME (zip in place) / --delete NAME (no undo)"))

        def pick(name):
            hits = by_name.get(name.lower())
            if not hits:
                raise InstallerError("'%s' isn't one of the unrecognized folders listed above." % name)
            return hits[0]

        for name in self.args.archive or []:
            e = pick(name)
            zp = archive_folder(e)
            self.out.log("Archived %s -> %s" % (e.name, zp))
        for name in self.args.delete or []:
            e = pick(name)
            if self.confirm('Permanently delete "%s"? This cannot be undone.' % e.name):
                remove_tree(e.path)
                self.out.log("Deleted " + e.name)
        return 0 if all(ok for ok, _ in checks) else 1

    def cmd_clear_cache(self):
        game = self.game(require=False)
        self.require_civ_closed()
        self.out.section("CLEAR GFX CACHE")
        for label, deleted, skipped in clear_gfx_caches(game):
            self.out.log("%s: %d deleted%s" % (label, deleted, ", %d in use/skipped" % skipped if skipped else ""))
        self.out.log("DONE. Caches rebuild automatically on next launch.")
        return 0

    def cmd_redownload(self):
        game = self.game(require=False)
        self.require_civ_closed()
        path = validate_game_folder(game)
        size = dir_size(path)
        self.out.section("REDOWNLOAD CIV")
        self.out.line(self.out.m("  Deletes the ENTIRE game folder:"))
        self.out.line("  " + path)
        self.out.line("  Steam then downloads it again (%s). Every mod and EUI in it is removed." % format_size(size))
        self.out.line("  Saves and settings in the Proton prefix are kept.")
        if self.args.confirm != "DELETE":
            if not sys.stdin.isatty():
                raise InstallerError("Refusing without confirmation: pass --confirm DELETE.")
            if input(self.out.m("  Type DELETE to confirm: ")).strip() != "DELETE":
                self.out.line("  Cancelled.")
                return 1
        self.require_civ_closed()
        removed = redownload_game(game, self.out.log, self.out.progress)
        self.out.done()
        return 0 if removed else 1

    def cmd_kill(self):
        if not is_civ_running():
            self.out.line("Civilization V isn't running.")
            return 0
        if not self.confirm("Force-closing ends the game immediately -- unsaved progress is lost. Continue?"):
            return 1
        n = force_close_civ()
        self.out.log("Killed %d Civilization V process%s." % (n, "" if n == 1 else "es"))
        return 0

    def cmd_open(self):
        game = self.game()
        if open_in_desktop(game.dlc):
            self.out.log("Opened " + game.dlc)
        else:
            self.out.line(game.dlc)
        return 0

    def cmd_settings(self):
        s = self.settings
        changed = False
        if self.args.set_beta is not None:
            s.show_beta = self.args.set_beta == "on"
            changed = True
        if self.args.set_civ_dir is not None:
            if self.args.set_civ_dir.lower() == "auto":
                s.civ_dir = None
            else:
                g = Game(os.path.expanduser(self.args.set_civ_dir))
                if g.problem():
                    raise InstallerError(g.problem())
                s.civ_dir = g.root
            changed = True
        if changed:
            s.save()
        self.out.section("SETTINGS")
        self.out.line("  beta builds  " + (self.out.m("on") if s.show_beta else self.out.m("off")))
        self.out.line("  civ folder   " + (s.civ_dir or self.out.d("auto-detect")))
        self.out.line(self.out.d("  file: " + Settings.PATH))
        return 0

    def cmd_install_self(self):
        self.out.section("INSTALLING " + APP_CMD.upper())
        ready = install_self(self.out.log)
        self.out.line("")
        if ready:
            self.out.line("  Done. Run it any time with:  " + APP_CMD)
        else:
            self.out.line("  Done. Open a new terminal, then run:  " + APP_CMD)
            self.out.line("  (or right now:  ~/.local/bin/" + APP_CMD + ")")
        self.out.line("  It's also in your app menu as 'Civ V Mod Installer'.")
        return 0

    def cmd_uninstall_self(self):
        if not self.confirm("Remove %s from this machine? Mods already installed in Civ V stay." % APP_CMD):
            return 1
        self.out.section("REMOVING " + APP_CMD.upper())
        uninstall_self(self.out.log)
        return 0

    def cmd_self_update(self):
        if in_git_checkout():
            raise InstallerError("This copy lives in a git checkout -- update it with `git pull` instead.")
        latest, data = fetch_latest_self()
        if not is_newer_version(latest, VERSION):
            self.out.line("Already up to date (v%s)." % VERSION)
            return 0
        apply_self_update(data)
        self.out.log("Updated v%s -> v%s." % (VERSION, latest))
        return 0


def build_parser():
    p = argparse.ArgumentParser(
        prog="civ5-mod",
        description="KEK Mod installer for Civilization V under Steam Proton. Run with no command "
                    "for the full-screen installer.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="mods: kekmod, tournament, lekmod    eui variants: eui, xits")
    p.add_argument("--civ-dir", metavar="DIR", help="Civ V folder (.../steamapps/common/%s) for this run" % CIV_FOLDER)
    p.add_argument("--no-color", action="store_true", help="plain output")
    p.add_argument("--ascii", action="store_true", help="full-screen UI without Unicode box art")
    p.add_argument("-y", "--yes", action="store_true", help="answer yes to confirmations")
    p.add_argument("--version", action="version", version="civ5-mod " + VERSION)
    sub = p.add_subparsers(dest="command", metavar="command")

    sub.add_parser("tui", help="full-screen installer (default)")
    s = sub.add_parser("status", help="installed mods, updates and checks")
    s.add_argument("--offline", action="store_true", help="skip the GitHub update check")
    for name, hlp in (("install", "install or update a mod"), ("uninstall", "remove a mod and its bonus map")):
        s = sub.add_parser(name, help=hlp)
        s.add_argument("mod", help="kekmod, tournament or lekmod")
        if name == "install":
            s.add_argument("--version", dest="version", metavar="TAG", help="exact release tag (default: latest)")
            s.add_argument("--beta", action="store_true", help="consider beta releases for 'latest'")
    s = sub.add_parser("versions", help="list a mod's releases")
    s.add_argument("mod")
    s.add_argument("--beta", action="store_true", help="include betas")
    s = sub.add_parser("eui", help="install/remove EUI")
    s.add_argument("action", choices=["install", "uninstall"])
    s.add_argument("variant", nargs="?", default="eui", help="eui (default) or xits")
    s = sub.add_parser("lobby", help="install/remove the lobby patch (worldwide lobby list)")
    s.add_argument("action", choices=["install", "uninstall"])
    s = sub.add_parser("verify", help="run every check and list unrecognized mod folders")
    s.add_argument("--archive", action="append", metavar="NAME", help="zip an unrecognized folder in place")
    s.add_argument("--delete", action="append", metavar="NAME", help="permanently delete an unrecognized folder")
    sub.add_parser("clear-cache", help="wipe shader caches + Civ V's cached DBs (black map fix)")
    s = sub.add_parser("redownload", help="delete the whole game folder and have Steam download it again")
    s.add_argument("--confirm", metavar="DELETE", help="skip the typed confirmation")
    sub.add_parser("kill", help="force close a running Civ V")
    sub.add_parser("open", help="open the DLC folder")
    s = sub.add_parser("settings", help="show or change settings")
    s.add_argument("--beta", dest="set_beta", choices=["on", "off"], help="enable beta builds")
    s.add_argument("--civ-dir", dest="set_civ_dir", metavar="DIR|auto", help="remember the Civ V folder")
    sub.add_parser("self-update", help="update this installer from GitHub")
    sub.add_parser("install-self", help="install this program as the `%s` command + app menu entry" % APP_CMD)
    sub.add_parser("uninstall-self", help="remove this program from the machine (mods stay)")
    return p


def main(argv=None):
    parser = build_parser()
    args = parser.parse_args(argv)
    for attr in ("beta", "version", "offline", "archive", "delete", "confirm", "set_beta", "set_civ_dir"):
        if not hasattr(args, attr):
            setattr(args, attr, None)
    color = not args.no_color and sys.stdout.isatty() and not os.environ.get("NO_COLOR")
    out = Out(color)
    command = args.command
    if command is None:
        command = "tui" if sys.stdin.isatty() and sys.stdout.isatty() else "status"
    try:
        if command == "tui":
            return run_tui(args)
        return getattr(Cli(args, out), "cmd_" + command.replace("-", "_"))()
    except InstallerError as e:
        out.error(str(e))
        return 1
    except KeyboardInterrupt:
        out.done()
        out.error("Interrupted.")
        return 130


# ══════════════════════════════════════════════════════════════════════════════
#  Full-screen installer (curses)
# ══════════════════════════════════════════════════════════════════════════════
# Same "cracktro" look as the WinForms build: black background, neon green
# text, magenta box art cut with [ TITLES ], a scrolling greetz ticker and a
# blinking "> STATUS_" line -- plus an ANSI-shadow logo with copper-bar color
# cycling when the terminal has 256 colors. Keyboard (arrows/Tab/Enter,
# hotkeys) and mouse both work.

LOGO_GLYPHS = {
    "C": [" ██████╗", "██╔════╝", "██║     ", "██║     ", "╚██████╗", " ╚═════╝"],
    "I": ["██╗", "██║", "██║", "██║", "██║", "╚═╝"],
    "V": ["██╗   ██╗", "██║   ██║", "██║   ██║", "╚██╗ ██╔╝", " ╚████╔╝ ", "  ╚═══╝  "],
    " ": ["   "] * 6,
}
LOGO = ["".join(LOGO_GLYPHS[ch][i] for ch in "CIV V") for i in range(6)]
LOGO_WIDTH = len(LOGO[0])
# Copper-bar cycle for the logo and ticker -- magentas only; green means "installed".
COPPER = [53, 89, 125, 161, 162, 199, 205, 199, 162, 161, 125, 89]
SPINNER = "|/-\\"
TICKER_CHARS_PER_SEC = 8


def run_tui(args):
    try:
        import curses  # noqa: F401
    except ImportError:
        raise InstallerError("This Python has no curses module -- use the commands instead (see --help).")
    locale.setlocale(locale.LC_ALL, "")
    os.environ.setdefault("ESCDELAY", "25")
    app = Tui(args)
    import curses
    curses.wrapper(app.main)
    return 0


def tail(s, width):
    """s cut from the left to fit width -- the end of a path is the useful part."""
    return s if len(s) <= width else "..." + s[-(width - 3):]


class Btn:
    def __init__(self, id, label, action, enabled=True, color="mag", short=None):
        self.id, self.label, self.action, self.enabled, self.color, self.short = id, label, action, enabled, color, short
        self.y = self.x = self.w = 0


class Tui:
    def __init__(self, args):
        import curses
        self.curses = curses
        self.args = args
        self.settings = Settings()
        self.game = None
        self.releases = {}
        self.releases_loaded = False
        self.state = State(None, {}, False)
        self.log_lines = []
        self.log_scroll = 0
        self.progress = 0
        self.status = "SYSTEM READY"
        self.busy = False
        self.q = queue.Queue()
        self.ticker = DEFAULT_TICKER
        self.latest_self = None
        self.focus = "mod:%s:install" % MODS[0].id
        self.buttons = []
        self.frame = 0

    # ── setup ──
    def main(self, scr):
        c = self.curses
        self.scr = scr
        c.curs_set(0)
        scr.keypad(True)
        scr.timeout(40)
        try:
            c.mousemask(c.BUTTON1_CLICKED | c.BUTTON1_PRESSED)
        except c.error:
            pass
        # What ncurses will actually emit -- not getpreferredencoding(), which
        # Python's UTF-8 mode reports as UTF-8 even under LC_ALL=C.
        self.uni = "utf" in (locale.nl_langinfo(locale.CODESET) or "").lower() and not self.args.ascii
        self._init_colors()
        self.boot()
        while True:
            self.pump()
            self.draw()
            k = scr.getch()
            if k == -1:
                continue
            if not self.handle_key(k):
                break

    def _init_colors(self):
        c = self.curses
        c.start_color()
        rich = c.COLORS >= 256
        self.rich = rich
        # Green is reserved for installed mods/maps/EUI; everything else is
        # magenta. "dim" is a dark magenta for decoration (shadows, empty
        # progress, key hints). Red is only for UPDATE buttons, as on Windows.
        G, D, M, R = (46, 89, 199, 203) if rich else (c.COLOR_GREEN, c.COLOR_MAGENTA, c.COLOR_MAGENTA, c.COLOR_RED)
        K = c.COLOR_BLACK
        for i, (fg, bg) in enumerate([(G, K), (D, K), (M, K), (K, G), (K, M), (R, K), (K, R)], 1):
            c.init_pair(i, fg, bg)
        self.attr = {
            "grn": c.color_pair(1) | c.A_BOLD, "dim": c.color_pair(2) | (0 if rich else c.A_DIM),
            "mag": c.color_pair(3) | c.A_BOLD,
            "grn_inv": c.color_pair(4) | c.A_BOLD, "mag_inv": c.color_pair(5) | c.A_BOLD,
            # disabled: same hue as the row's install state, just not bold
            "grn_off": c.color_pair(1), "mag_off": c.color_pair(3),
            "red": c.color_pair(6) | c.A_BOLD, "red_inv": c.color_pair(7) | c.A_BOLD, "red_off": c.color_pair(6),
        }
        self.copper = []
        if rich and c.COLOR_PAIRS > 40:
            for i, col in enumerate(COPPER):
                c.init_pair(20 + i, col, K)
                self.copper.append(c.color_pair(20 + i) | c.A_BOLD)
        self.scr.bkgd(" ", c.color_pair(1))

    def boot(self):
        self.log("CIV V MOD INSTALLER v%s // LINUX EDITION" % VERSION)
        self.game = find_game(self.settings, self.args.civ_dir)
        if self.game is None:
            self.log("Steam libraries scanned: Civilization V not found.")
            self.ask_civ_dir(first_run=True)
        if self.game:
            self.log("game:   " + self.game.root)
            problem = self.game.problem()
            if problem:
                self.log("ERROR: " + problem)
                self.msgbox("WRONG GAME BUILD", problem, color="mag")
            else:
                self.log("prefix: " + (self.game.prefix or "none yet (launch Civ V once under Proton)"))
        self.refresh_state()
        self.log("Fetching release lists...")
        self.status = "CONNECTING TO GITHUB"
        threading.Thread(target=self._fetch_thread, daemon=True).start()
        self.civ_running_dialog()
        self.startup_warnings()

    def _fetch_thread(self):
        rel = {}
        for mod in MODS:
            try:
                rel[mod.id] = mod.source.list_releases()
            except Exception:
                pass
        try:
            rel[LOBBY_REPO] = lobby_latest_tag()
        except Exception:
            pass
        ticker = fetch_ticker()
        latest = None
        if not in_git_checkout():  # a checkout updates with git pull
            try:
                latest = fetch_latest_self()[0]
            except Exception:
                pass
        # Make sure the exact-match check has the bundled EUI to compare with.
        if not BUNDLE.zips():
            try:
                BUNDLE.fetch_exe()
            except Exception:
                pass
        self.q.put(("fetched", (rel, ticker, latest)))

    # ── worker plumbing ──
    def log(self, msg):
        for line in str(msg).split("\n"):
            self.log_lines.append(line)
        del self.log_lines[:-1000]
        self.log_scroll = 0

    def pump(self):
        while True:
            try:
                kind, payload = self.q.get_nowait()
            except queue.Empty:
                break
            if kind == "log":
                self.log(payload)
            elif kind == "progress":
                self.progress = payload
            elif kind == "done":
                status, err = payload
                self.busy = False
                if err:
                    self.status = "FAILED: " + err
                    self.log("ERROR: " + err)
                else:
                    self.status = status
                self.refresh_state()
            elif kind == "fetched":
                rel, ticker, latest = payload
                self.releases = rel
                self.releases_loaded = True
                if ticker:
                    self.ticker = ticker
                if latest and is_newer_version(latest, VERSION):
                    self.latest_self = latest
                    self.log("Installer update available: v%s (press U)." % latest)
                missing = [m.name for m in MODS if m.id not in rel]
                self.log("Release lists: %d/%d loaded%s." % (len(MODS) - len(missing), len(MODS),
                         "" if not missing else " (offline for " + ", ".join(missing) + ")"))
                if not self.busy:
                    self.status = "SYSTEM READY"
                self.refresh_state()

    def start_job(self, status, fn):
        self.busy = True
        self.progress = 0
        self.status = status
        self.log_lines.append("")

        def run():
            try:
                result = fn(lambda m: self.q.put(("log", m)), lambda p: self.q.put(("progress", p)))
                self.q.put(("done", (result or "DONE.", None)))
            except InstallerError as e:
                self.q.put(("done", (None, str(e))))
            except Exception as e:  # a bug, but never leave the UI stuck busy
                self.q.put(("done", (None, "%s: %s" % (type(e).__name__, e))))
        threading.Thread(target=run, daemon=True).start()

    def refresh_state(self):
        try:
            self.state = State(self.game, self.releases, self.settings.show_beta)
        except OSError as e:
            self.log("ERROR: couldn't read the game folder (%s)" % e)

    # ── drawing primitives ──
    def put(self, y, x, s, attr=0, maxw=None):
        h, w = self.scr.getmaxyx()
        if y < 0 or y >= h or x >= w:
            return
        if x < 0:
            s, x = s[-x:], 0
        if maxw is not None:
            s = s[:max(0, maxw)]
        # curses errors on writing the bottom-right cell; stop one short there.
        s = s[:w - x - (1 if y == h - 1 else 0)]
        if not s:
            return
        try:
            self.scr.addstr(y, x, s, attr)
        except self.curses.error:
            pass

    def ch(self, name):
        u = {"tl": "╔", "tr": "╗", "bl": "╚", "br": "╝", "h": "═", "v": "║", "dot": "●", "hol": "○",
             "full": "█", "empty": "░", "branch": "└─", "sh": "▒", "arrow": "»"}
        a = {"tl": "+", "tr": "+", "bl": "+", "br": "+", "h": "-", "v": "|", "dot": "*", "hol": "o",
             "full": "#", "empty": ".", "branch": "`-", "sh": ":", "arrow": ">"}
        return (u if self.uni else a)[name]

    def box(self, y, x, h, w, title=None, color="mag", fill=False, shadow=False):
        a = self.attr[color]
        if fill:
            for i in range(1, h - 1):
                self.put(y + i, x + 1, " " * (w - 2), self.attr["mag"])
        if shadow:
            sa = self.attr["dim"]
            for i in range(1, h + 1):
                self.put(y + i, x + w, self.ch("sh") * 2, sa)
            self.put(y + h, x + 2, self.ch("sh") * w, sa)
        self.put(y, x, self.ch("tl") + self.ch("h") * (w - 2) + self.ch("tr"), a)
        for i in range(1, h - 1):
            self.put(y + i, x, self.ch("v"), a)
            self.put(y + i, x + w - 1, self.ch("v"), a)
        self.put(y + h - 1, x, self.ch("bl") + self.ch("h") * (w - 2) + self.ch("br"), a)
        if title:
            self.put(y, x + 2, "[ ", a)
            self.put(y, x + 4, title, self.attr["mag"])
            self.put(y, x + 4 + len(title), " ]", a)

    def button(self, b, y, x, w, registry):
        b.y, b.x, b.w = y, x, w
        label = b.label if len(b.label) + 4 <= w or not b.short else b.short
        inner = label[:max(0, w - 2)].center(max(0, w - 2))
        focused = self.focus == b.id and b.enabled
        if not b.enabled:
            attr = self.attr[b.color + "_off"]
        elif focused:
            attr = self.attr[b.color + "_inv"]
        else:
            attr = self.attr[b.color]
        if focused:
            self.put(y, x, ("▶" if self.uni else ">") + inner + ("◀" if self.uni else "<"), attr)
        else:
            self.put(y, x, "[" + inner + "]", attr)
        registry.append(b)

    # ── main screen ──
    def draw(self, refresh=True):
        self.frame += 1
        scr = self.scr
        scr.erase()
        h, w = scr.getmaxyx()
        self.buttons = []
        if h < 25 or w < 72:
            self.put(h // 2, max(0, (w - 34) // 2), "TERMINAL TOO SMALL -- NEED 72x25", self.attr["mag"])
            self.put(h // 2 + 1, max(0, (w - 20) // 2), "(now %dx%d, Q quits)" % (w, h), self.attr["dim"])
            if refresh:
                scr.refresh()
            return
        W = min(w, 104)
        x0 = (w - W) // 2
        big = h >= 40 and W >= 78 and self.uni
        y = self._draw_header(x0, W, big)
        y = self._draw_mods(y, x0, W)
        y = self._draw_eui(y, x0, W)
        y = self._draw_lobby(y, x0, W)
        # progress + status
        bar_w = W - 8
        fill = bar_w * self.progress // 100
        self.put(y, x0, "[", self.attr["mag"])
        self.put(y, x0 + 1, self.ch("full") * fill, self.attr["mag"])
        self.put(y, x0 + 1 + fill, self.ch("empty") * (bar_w - fill), self.attr["dim"])
        self.put(y, x0 + 1 + bar_w, "]", self.attr["mag"])
        self.put(y, x0 + 3 + bar_w, "%3d%%" % self.progress, self.attr["mag"])
        y += 1
        cursor = "_" if (self.frame // 12) % 2 == 0 else " "
        spin = (SPINNER[(self.frame // 3) % 4] + " ") if (self.busy or not self.releases_loaded) else ""
        status_attr = self.attr["mag"] if self.status.startswith("FAILED") else self.attr["mag"]
        self.put(y, x0, "> " + spin + self.status + cursor, status_attr, maxw=W)
        y += 1
        # log
        log_h = h - 2 - y
        self._draw_log(y, x0, W, log_h)
        self._draw_bottom(h - 2, x0, W)
        self._draw_ticker(h - 1, x0, W)
        # Focus stays on a button that's only disabled for now (busy) and
        # resumes there; it only moves if that button is gone entirely.
        if self.focus not in [b.id for b in self.buttons]:
            first = next((b for b in self.buttons if b.enabled), None)
            self.focus = first.id if first else None
        if refresh:
            scr.refresh()

    def _draw_header(self, x0, W, big):
        btns = []
        if self.latest_self:
            btns.append(Btn("update", "UPDATE v" + self.latest_self, self.on_self_update, not self.busy, "red", "UPDATE"))
        btns.append(Btn("setup", "SETUP", self.on_settings, not self.busy))
        tag = "-=[ v%s // LINUX @OBLAST ]=-" % VERSION
        if big:
            for i, row in enumerate(LOGO):
                for j, chh in enumerate(row):
                    if chh == "█":
                        a = self.copper[(i + self.frame // 4) % len(self.copper)] if self.copper else self.attr["mag"]
                    elif chh == " ":
                        continue
                    else:
                        a = self.attr["mag"]
                    self.put(i, x0 + 1 + j, chh, a)
            rx = x0 + LOGO_WIDTH + 5
            self.put(0, rx, "M O D   I N S T A L L E R", self.attr["mag"])
            self.put(2, rx, tag, self.attr["mag"])
            bx = rx
            for b in btns:
                bw = min(len(b.label) + 4, x0 + W - bx)
                self.button(b, 4, bx, bw, self.buttons)
                bx += bw + 1
            y = 6
        else:
            self.put(0, x0, "CIV V MOD INSTALLER", self.attr["mag"])
            self.put(0, x0 + 21, tag, self.attr["mag"])
            bx = x0 + W
            for b in reversed(btns):
                lbl = b.short if (b.short and x0 + 21 + len(tag) + 20 > bx - len(b.label)) else b.label
                bw = len(lbl) + 4
                bx -= bw
                b.label = lbl
                self.button(b, 0, bx, bw, self.buttons)
                bx -= 1
            y = 1
        self.put(y, x0, self.ch("h") * W, self.attr["mag"])
        return y + 1

    def _mod_buttons(self, mod):
        st = self.state
        installed = mod.id in st.installed
        update = mod.id in st.updates
        ok = not self.busy
        col = "grn" if installed else "mag"
        return [Btn("mod:%s:install" % mod.id, "UPDATE" if update else ("REINSTALL" if installed else "INSTALL"),
                    lambda: self.on_install(mod), ok, "red" if update else col),
                Btn("mod:%s:uninstall" % mod.id, "UNINSTALL", lambda: self.on_uninstall(mod), ok and installed, col),
                Btn("mod:%s:version" % mod.id, "VERSION", lambda: self.on_version(mod), ok, col)]

    def _draw_mods(self, y, x0, W):
        rows = 2 * len(MODS)
        self.box(y, x0, rows + 2, W, "GAME MODS", "mag")
        bw = 13
        bx = x0 + W - 2 - (3 * bw + 2)
        self._col_x = [bx, bx + bw + 1, bx + 2 * (bw + 1)]
        st = self.state
        for i, mod in enumerate(MODS):
            ry = y + 1 + 2 * i
            installed = mod.id in st.installed
            a = self.attr["grn"] if installed else self.attr["mag"]
            self.put(ry, x0 + 2, self.ch("dot") if installed else self.ch("hol"), a)
            name = mod.name.upper()
            self.put(ry, x0 + 4, name, a)
            nx = x0 + 4 + len(name) + 2
            if installed:
                v = st.mod_version(mod)
                self.put(ry, nx, v, a, maxw=bx - nx - 1)
                nx += len(v) + 2
            if mod.id in st.updates:
                self.put(ry, nx, "%s %s available" % (self.ch("arrow"), st.updates[mod.id]), a, maxw=bx - nx - 1)
            for b, cx in zip(self._mod_buttons(mod), self._col_x):
                self.button(b, ry, cx, bw, self.buttons)
            if mod.extra:
                ev = st.extras.get(mod.extra.id)
                ea = self.attr["grn"] if ev is not None else self.attr["mag"]
                self.put(ry + 1, x0 + 4, self.ch("branch"), ea)
                self.put(ry + 1, x0 + 7, self.ch("dot") if ev is not None else self.ch("hol"), ea)
                self.put(ry + 1, x0 + 9, mod.extra.name + ("  " + ev if ev else ""), ea)
                if installed and ev is None:
                    self.put(ry + 1, x0 + 11 + len(mod.extra.name), "missing -- reinstall to add it", ea)
        return y + rows + 2

    def _draw_eui(self, y, x0, W):
        n = len(EUI_VARIANTS)
        self.box(y, x0, n + 2, W, "INTERFACE MODS", "mag")
        bw = 13
        st = self.state
        for i, v in enumerate(EUI_VARIANTS):
            ry = y + 1 + i
            active = st.eui == v.id
            mismatch = active and st.eui_match is False
            a = self.attr["grn"] if active else self.attr["mag"]
            self.put(ry, x0 + 2, "!" if mismatch else (self.ch("dot") if active else self.ch("hol")), a)
            self.put(ry, x0 + 4, (v.name + " -- VERSION MISMATCH") if mismatch else v.label(), a)
            col = "grn" if active else "mag"
            ok = not self.busy
            for b, cx in zip([Btn("eui:%s:install" % v.id, "REINSTALL" if active else "INSTALL",
                                  lambda v=v: self.on_eui_install(v), ok, col),
                              Btn("eui:%s:uninstall" % v.id, "UNINSTALL", self.on_eui_remove, ok and active, col)],
                             self._col_x):
                self.button(b, ry, cx, bw, self.buttons)
        return y + n + 2

    def _draw_lobby(self, y, x0, W):
        self.box(y, x0, 3, W, "NETWORK MODS", "mag")
        bw = 13
        st = self.state
        ry = y + 1
        installed = st.lobby is not None
        a = self.attr["grn"] if installed else self.attr["mag"]
        self.put(ry, x0 + 2, self.ch("dot") if installed else self.ch("hol"), a)
        label = LOBBY_NAME + ("  " + st.lobby if st.lobby else "")
        self.put(ry, x0 + 4, label, a, maxw=self._col_x[0] - x0 - 5)
        if st.lobby_update:
            nx = x0 + 6 + len(label)
            self.put(ry, nx, "%s %s available" % (self.ch("arrow"), st.lobby_update), a, maxw=self._col_x[0] - nx - 1)
        col = "grn" if installed else "mag"
        ok = not self.busy
        for b, cx in zip([Btn("lobby:install", "UPDATE" if st.lobby_update else ("REINSTALL" if installed else "INSTALL"),
                              self.on_lobby_install, ok, "red" if st.lobby_update else col),
                          Btn("lobby:uninstall", "UNINSTALL", self.on_lobby_remove, ok and installed, col)],
                         self._col_x):
            self.button(b, ry, cx, bw, self.buttons)
        return y + 3

    def _wrap_log(self, width):
        out = []
        for line in self.log_lines:
            if line.startswith(("ERROR", "FAILED")) or "couldn't" in line.lower() or "warning" in line.lower():
                a = self.attr["mag"]
            elif line.startswith("CIV V MOD INSTALLER"):
                a = self.attr["mag"]
            else:
                a = self.attr["mag"]
            for part in (textwrap.wrap(line, width, subsequent_indent="  ") or [""]):
                out.append((part, a))
        return out

    def _draw_log(self, y, x0, W, h):
        hint = " %s MOVE  ENTER SELECT  PGUP/DN LOG  S SETUP  Q QUIT " % ("↑↓←→" if self.uni else "ARROWS")
        self.box(y, x0, h, W, "LOG", "mag")
        if len(hint) + 6 < W:
            self.put(y + h - 1, x0 + W - len(hint) - 3, hint, self.attr["dim"])
        inner = h - 2
        lines = self._wrap_log(W - 4)
        max_scroll = max(0, len(lines) - inner)
        self.log_scroll = min(self.log_scroll, max_scroll)
        start = max(0, len(lines) - inner - self.log_scroll)
        for i, (text, a) in enumerate(lines[start:start + inner]):
            self.put(y + 1 + i, x0 + 2, text, a)
        if self.log_scroll:
            self.put(y, x0 + W - 14, "[ +%d ]" % self.log_scroll, self.attr["mag"])

    def _draw_bottom(self, y, x0, W):
        ok = not self.busy
        # No LAUNCH CIV button, same as Windows (Installer.cs hides its LAUNCH
        # DX9/DX11): steam://rungameid starts whichever renderer Steam last
        # picked, and DX9 draws a black map on some machines. Force close
        # lives in civ_running_dialog.
        btns = [Btn("open", "OPEN DLC FOLDER", self.on_open, True, "mag", "OPEN DLC"),
                Btn("verify", "VERIFY MODS", self.on_verify, ok, "mag", "VERIFY"),
                Btn("gfx", "CLEAR GFX CACHE", self.on_clear_gfx, ok, "mag", "CLEAR GFX"),
                Btn("reset", "REDOWNLOAD CIV", self.on_redownload, ok, "mag", "REDOWNLOAD")]
        n = len(btns)
        bw = (W - (n - 1)) // n
        for i, b in enumerate(btns):
            width = bw if i < n - 1 else W - (n - 1) * (bw + 1)
            self.button(b, y, x0 + i * (bw + 1), width, self.buttons)

    def _draw_ticker(self, y, x0, W):
        text = "   " + self.ticker + "   "
        # Clock-based, not per frame: redraws on every keypress would
        # otherwise speed it up while keys are held.
        pos = int(time.monotonic() * TICKER_CHARS_PER_SEC) % len(text)
        view = (text * (W // len(text) + 2))[pos:pos + W]
        for i, chh in enumerate(view):
            a = self.copper[(i + self.frame // 2) % len(self.copper)] if self.copper else self.attr["mag"]
            self.put(y, x0 + i, chh, a)

    # ── input ──
    def handle_key(self, k):
        c = self.curses
        if k in (ord("q"), ord("Q"), 27):
            if self.busy and self.msgbox("QUIT", "Something is still being installed. Quit anyway? That can "
                                         "leave a half-installed mod behind.", ["QUIT", "STAY"], "mag", 1, 1) != 0:
                return True
            return False
        if k == c.KEY_RESIZE:
            return True
        if k == c.KEY_MOUSE:
            self._click(self.buttons)
            return True
        if k in (ord("s"), ord("S")) and not self.busy:
            self.on_settings()
        elif k in (ord("u"), ord("U")) and self.latest_self and not self.busy:
            self.on_self_update()
        elif k == c.KEY_PPAGE:
            self.log_scroll += 5
        elif k == c.KEY_NPAGE:
            self.log_scroll = max(0, self.log_scroll - 5)
        elif k in (10, 13, c.KEY_ENTER, ord(" ")):
            b = next((b for b in self.buttons if b.id == self.focus and b.enabled), None)
            if b:
                b.action()
        else:
            self._navigate(k, self.buttons)
        return True

    def _click(self, buttons):
        try:
            _id, mx, my, _z, _bs = self.curses.getmouse()
        except self.curses.error:
            return
        for b in buttons:
            if b.enabled and b.y == my and b.x <= mx < b.x + b.w:
                self.focus = b.id
                b.action()
                return

    def _navigate(self, k, buttons):
        c = self.curses
        live = [b for b in buttons if b.enabled]
        if not live:
            return
        cur = next((b for b in buttons if b.id == self.focus), live[0])
        if k in (9, c.KEY_BTAB):
            order = sorted(live + ([] if cur in live else [cur]), key=lambda b: (b.y, b.x))
            i = order.index(cur)
            self.focus = order[(i + (1 if k == 9 else -1)) % len(order)].id
            return
        if k in (c.KEY_LEFT, ord("h")):
            cand = [b for b in live if b.y == cur.y and b.x < cur.x]
            pick = max(cand, key=lambda b: b.x) if cand else None
        elif k in (c.KEY_RIGHT, ord("l")):
            cand = [b for b in live if b.y == cur.y and b.x > cur.x]
            pick = min(cand, key=lambda b: b.x) if cand else None
        elif k in (c.KEY_UP, ord("k"), c.KEY_DOWN, ord("j")):
            up = k in (c.KEY_UP, ord("k"))
            ys = sorted({b.y for b in live if (b.y < cur.y if up else b.y > cur.y)}, reverse=up)
            pick = None
            if ys:
                row = [b for b in live if b.y == ys[0]]
                center = cur.x + cur.w // 2
                pick = min(row, key=lambda b: abs(b.x + b.w // 2 - center))
        else:
            return
        if pick:
            self.focus = pick.id

    # ── dialogs ──
    def _dialog_loop(self, draw_fn, key_fn):
        """Runs a modal: the main screen keeps animating underneath."""
        saved_focus = self.focus
        try:
            while True:
                self.pump()
                self.draw(refresh=False)
                draw_fn()
                self.scr.refresh()
                k = self.scr.getch()
                if k == -1 or k == self.curses.KEY_RESIZE:
                    continue
                res = key_fn(k)
                if res is not None:
                    return res[0]
        finally:
            self.focus = saved_focus

    def _dialog_frame(self, title, width, height, color):
        h, w = self.scr.getmaxyx()
        width = min(width, w - 4)
        height = min(height, h - 2)
        y, x = max(0, (h - height) // 2), max(0, (w - width) // 2)
        self.box(y, x, height, width, title, color, fill=True, shadow=True)
        return y, x, width, height

    def msgbox(self, title, text, buttons=("OK",), color="mag", default=0, escape=None):
        """Returns the chosen button index (escape on ESC/q)."""
        state = {"focus": default, "btns": []}
        width = 66

        def draw():
            lines = []
            for para in text.split("\n"):
                lines += textwrap.wrap(para, width - 6) or [""]
            y, x, W, H = self._dialog_frame(title, width, len(lines) + 5, color)
            for i, line in enumerate(lines):
                self.put(y + 2 + i, x + 3, line, self.attr["mag"])
            labels = list(buttons)
            bws = [len(l) + 4 for l in labels]
            bx = x + W - 2 - sum(bws) - (len(labels) - 1)
            state["btns"] = []
            for i, l in enumerate(labels):
                b = Btn(i, l, None, True, "mag")
                self.focus = state["focus"]
                self.button(b, y + H - 2, bx, bws[i], state["btns"])
                bx += bws[i] + 1

        def key(k):
            c = self.curses
            if k in (27, ord("q")) and escape is not None:
                return (escape,)
            if k in (10, 13, c.KEY_ENTER, ord(" ")):
                return (state["focus"],)
            if k in (c.KEY_LEFT, c.KEY_BTAB, ord("h")):
                state["focus"] = (state["focus"] - 1) % len(buttons)
            elif k in (c.KEY_RIGHT, 9, ord("l")):
                state["focus"] = (state["focus"] + 1) % len(buttons)
            elif k == c.KEY_MOUSE:
                hit = self._hit(state["btns"])
                if hit is not None:
                    return (hit.id,)
            return None
        return self._dialog_loop(draw, key)

    def _hit(self, btns):
        try:
            _id, mx, my, _z, _bs = self.curses.getmouse()
        except self.curses.error:
            return None
        return next((b for b in btns if b.enabled and b.y == my and b.x <= mx < b.x + b.w), None)

    def prompt(self, title, text, initial="", confirm_word=None, ok_label="OK", color="mag"):
        """Text field dialog. With confirm_word, OK stays disabled until the
        exact word is typed and Enter in the field never confirms."""
        st = {"value": initial, "focus": "field", "btns": []}
        c = self.curses

        def ok_enabled():
            return st["value"].strip() == confirm_word if confirm_word else bool(st["value"].strip())

        def draw():
            lines = []
            for para in text.split("\n"):
                lines += textwrap.wrap(para, 66 - 6) or [""]
            y, x, W, H = self._dialog_frame(title, 72, len(lines) + 7, color)
            for i, line in enumerate(lines):
                self.put(y + 2 + i, x + 3, line, self.attr["mag"])
            fy = y + 2 + len(lines) + 1
            fw = W - 6
            val = st["value"][-(fw - 2):]
            cur = "_" if (self.frame // 10) % 2 == 0 and st["focus"] == "field" else " "
            self.put(fy, x + 3, "[" + (val + cur).ljust(fw - 2) + "]",
                     self.attr["mag"] | (self.curses.A_UNDERLINE if st["focus"] == "field" else 0))
            st["btns"] = []
            labels = [(ok_label, ok_enabled(), "mag"), ("CANCEL", True, "mag")]
            bx = x + W - 2 - sum(len(l) + 4 for l, _e, _c in labels) - 1
            for i, (l, en, col) in enumerate(labels):
                b = Btn(i, l, None, en, col)
                self.focus = st["focus"]
                self.button(b, y + H - 2, bx, len(l) + 4, st["btns"])
                bx += len(l) + 5

        def key(k):
            if k == 27:
                return (None,)
            if k == c.KEY_MOUSE:
                hit = self._hit(st["btns"])
                if hit is not None:
                    return (st["value"].strip(),) if hit.id == 0 else (None,)
                return None
            if k in (9, c.KEY_DOWN, c.KEY_BTAB, c.KEY_UP):
                order = ["field", 0, 1] if ok_enabled() else ["field", 1]
                i = order.index(st["focus"]) if st["focus"] in order else 0
                st["focus"] = order[(i + (-1 if k in (c.KEY_BTAB, c.KEY_UP) else 1)) % len(order)]
                return None
            if st["focus"] == "field":
                if k in (10, 13, c.KEY_ENTER):
                    if ok_enabled() and not confirm_word:
                        return (st["value"].strip(),)
                    if ok_enabled():
                        st["focus"] = 0
                elif k in (c.KEY_BACKSPACE, 127, 8):
                    st["value"] = st["value"][:-1]
                elif 32 <= k < 0x110000 and k not in (c.KEY_LEFT, c.KEY_RIGHT):
                    try:
                        chh = chr(k)
                    except ValueError:
                        return None
                    if chh.isprintable():
                        st["value"] += chh.upper() if confirm_word else chh
                return None
            if k in (c.KEY_LEFT, c.KEY_RIGHT):
                st["focus"] = 1 if st["focus"] == 0 else (0 if ok_enabled() else 1)
            elif k in (10, 13, c.KEY_ENTER, ord(" ")):
                return (st["value"].strip(),) if st["focus"] == 0 and ok_enabled() else (None,)
            return None
        return self._dialog_loop(draw, key)

    def pick(self, title, items, selected=0):
        """items: [(label, attr_name)]. Returns index or None."""
        st = {"sel": selected, "top": 0}
        c = self.curses

        def draw():
            h, _w = self.scr.getmaxyx()
            rows = min(len(items), max(3, h - 10))
            y, x, W, H = self._dialog_frame(title, 60, rows + 5, "mag")
            if st["sel"] < st["top"]:
                st["top"] = st["sel"]
            if st["sel"] >= st["top"] + rows:
                st["top"] = st["sel"] - rows + 1
            for i in range(rows):
                idx = st["top"] + i
                if idx >= len(items):
                    break
                label, an = items[idx]
                a = self.attr["mag_inv"] if idx == st["sel"] else self.attr[an]
                self.put(y + 2 + i, x + 3, (" " + label).ljust(W - 6)[:W - 6], a)
                st.setdefault("rows", {})[y + 2 + i] = idx
            self.put(y + H - 2, x + 3, "ENTER install  ESC cancel", self.attr["dim"])
            if len(items) > rows:
                self.put(y + H - 2, x + W - 12, "%d/%d" % (st["sel"] + 1, len(items)), self.attr["mag"])

        def key(k):
            if k in (27, ord("q")):
                return (None,)
            if k in (10, 13, c.KEY_ENTER, ord(" ")):
                return (st["sel"],)
            if k in (c.KEY_UP, ord("k")):
                st["sel"] = max(0, st["sel"] - 1)
            elif k in (c.KEY_DOWN, ord("j"), 9):
                st["sel"] = min(len(items) - 1, st["sel"] + 1)
            elif k == c.KEY_PPAGE:
                st["sel"] = max(0, st["sel"] - 10)
            elif k == c.KEY_NPAGE:
                st["sel"] = min(len(items) - 1, st["sel"] + 10)
            elif k == c.KEY_MOUSE:
                try:
                    _i, _mx, my, _z, _b = c.getmouse()
                except c.error:
                    return None
                idx = st.get("rows", {}).get(my)
                if idx is not None:
                    return (idx,)
            return None
        return self._dialog_loop(draw, key)

    # ── flows ──
    def need_game(self):
        if self.game is None:
            self.ask_civ_dir()
            if self.game is None:
                return False
        problem = self.game.problem()
        if problem:
            self.msgbox("WRONG GAME BUILD", problem, color="mag")
            return False
        return True

    def ask_civ_dir(self, first_run=False):
        while True:
            choice = self.msgbox("CIVILIZATION V NOT FOUND",
                                 "Couldn't find Civilization V in any Steam library. Enter its folder "
                                 "(.../steamapps/common/%s) -- it's remembered for next time." % CIV_FOLDER,
                                 ["ENTER PATH", "CONTINUE" if first_run else "CANCEL"], "mag", 0, 1)
            if choice != 0:
                return
            path = self.prompt("CIV V FOLDER", "Path to the Civ V install folder:", self.settings.civ_dir or "")
            if not path:
                return
            g = Game(os.path.expanduser(path))
            if not os.path.isdir(g.root):
                self.msgbox("NOT FOUND", g.root + " doesn't exist.", color="mag")
                continue
            self.game = g
            self.settings.civ_dir = g.root
            self.settings.save()
            self.log("game:   " + g.root + " (saved)")
            self.refresh_state()
            return

    def civ_running_dialog(self):
        """RETRY / FORCE CLOSE / CANCEL until the game is gone or the player
        gives up. True when it's safe to touch the game files."""
        while is_civ_running():
            choice = self.msgbox("CIVILIZATION V IS RUNNING",
                                 "Please close the game before installing or uninstalling mods, then choose Retry.",
                                 ["RETRY", "FORCE CLOSE", "CANCEL"], "mag", 0, 2)
            if choice == 2:
                return False
            if choice == 1:
                self.log("Force closed %d Civ V process(es)." % force_close_civ())
        return True

    def startup_warnings(self):
        st = self.state
        inst = st.installed_mods()
        if len(inst) >= 2:
            self.msgbox("CONFLICTING MODS INSTALLED", " and ".join(m.name for m in inst)
                        + " are both installed. They can't run together -- uninstall one.", color="mag")
        missing = st.missing_maps()
        if missing:
            self.msgbox("MISSING BONUS MAP", "\n".join("%s is missing its %s." % (m.name, m.extra.name) for m in missing)
                        + "\n\nReinstall to add it.", color="mag")
        if st.eui == "eui_xits" and TOURNAMENT.id in st.installed:
            self.msgbox("NOT COMPATIBLE", "Tournament Mod and EUI XITS are not compatible.", color="mag")

    def confirm_tm_xits(self):
        return self.msgbox("NOT COMPATIBLE", "Tournament Mod and EUI XITS are not compatible. Install anyway?",
                           ["INSTALL", "CANCEL"], "mag", 1, 1) == 0

    def on_install(self, mod, tag=None):
        if self.busy or not self.need_game() or not self.civ_running_dialog():
            return
        st = self.state
        if mod is TOURNAMENT and st.eui == "eui_xits" and not self.confirm_tm_xits():
            return
        conflicts = [m for m in st.installed_mods() if m is not mod]
        if conflicts:
            names = ", ".join(m.name for m in conflicts)
            if self.msgbox("INSTALL " + mod.name.upper(),
                           "Installing %s will uninstall %s first -- these mods can't run side by side in "
                           "Civilization V. Continue?" % (mod.name, names),
                           ["CONTINUE", "CANCEL"], "mag", 1, 1) != 0:
                return
        game, beta = self.game, self.settings.show_beta

        def job(log, progress):
            for cm in conflicts:
                log("=== REMOVING %s ===" % cm.name.upper())
                uninstall_mod(game, cm, log, progress)
            log("=== INSTALLING %s ===" % mod.name.upper())
            return "[INSTALLED] " + install_mod(game, mod, tag, beta, log, progress)
        self.start_job("INSTALLING %s..." % mod.name.upper(), job)

    def on_uninstall(self, mod):
        if self.busy or not self.need_game() or not self.civ_running_dialog():
            return
        game = self.game

        def job(log, progress):
            log("=== REMOVING %s ===" % mod.name.upper())
            uninstall_mod(game, mod, log, progress)
            return "UNINSTALLED."
        self.start_job("REMOVING %s FILES..." % mod.name.upper(), job)

    def on_version(self, mod):
        if self.busy:
            return
        rels = self.releases.get(mod.id) or []
        beta = self.settings.show_beta and mod.beta_optin
        current = (self.state.mod_version(mod) or "").lower()
        items = [("Latest (auto -- newest, incl. beta)" if beta else "Latest (auto)", "mag")]
        tags = [None]
        for r in rels:
            if r.prerelease and not self.settings.show_beta:
                continue
            label = r.tag
            if r.extra:
                label += "  - " + r.extra
            if mod.beta_optin:
                label += "  [beta]" if r.prerelease else "  [stable]"
            if r.tag.lower() == current:
                label += "  " + ("◄" if self.uni else "<") + " installed"
            items.append((label, "mag"))
            tags.append(r.tag)
        if not rels:
            items.append(("(release list unavailable -- offline?)", "dim"))
        idx = self.pick(mod.name.upper() + " VERSION", items, 0)
        if idx is None or idx >= len(tags):
            return
        self.status = "%s version set to %s" % (mod.name, tags[idx] or "auto")
        self.on_install(mod, tags[idx])

