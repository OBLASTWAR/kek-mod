# ── Bundled EUI (read out of KekModInstaller.exe) ─────────────────────────────

class Bundle:
    """The EUI zips the Windows build embeds as .NET manifest resources.

    Looked up in order: loose zips next to the Windows sources (dev machine),
    this checkout's KekModInstaller.exe, a cached copy of main's exe. The
    resources blob in a .NET PE is a run of 8-byte-aligned [u32 length][data]
    entries; zips are told apart by their top-level folder name."""

    def __init__(self):
        self._zips = None

    def _exe_candidates(self):
        return [os.path.join(os.path.dirname(SCRIPT_DIR), "KekModInstaller.exe"),
                os.path.join(SCRIPT_DIR, "KekModInstaller.exe"),
                os.path.join(CACHE_DIR, "KekModInstaller.exe")]

    def local_exe(self):
        return next((p for p in self._exe_candidates() if os.path.isfile(p)), None)

    def fetch_exe(self, log=None):
        """Downloads main's KekModInstaller.exe into the cache (~6 MB)."""
        os.makedirs(CACHE_DIR, exist_ok=True)
        dest = os.path.join(CACHE_DIR, "KekModInstaller.exe")
        if log:
            log("Fetching bundled EUI (KekModInstaller.exe from GitHub)...")
        tmp = dest + ".part"
        download_to(RAW_MAIN + "/" + EXE_REPO_PATH, tmp)
        os.replace(tmp, dest)
        self._zips = None
        return dest

    @staticmethod
    def _resources(exe_bytes):
        d = exe_bytes
        pe = struct.unpack_from("<I", d, 0x3C)[0]
        nsec = struct.unpack_from("<H", d, pe + 6)[0]
        optsz = struct.unpack_from("<H", d, pe + 20)[0]
        opt = pe + 24
        datadirs = opt + (112 if struct.unpack_from("<H", d, opt)[0] == 0x20B else 96)
        sections = []
        for i in range(nsec):
            s = opt + optsz + 40 * i
            vsize, va = struct.unpack_from("<II", d, s + 8)
            sections.append((va, vsize, struct.unpack_from("<I", d, s + 20)[0]))

        def offset(rva):
            for va, vsize, raw in sections:
                if va <= rva < va + vsize:
                    return rva - va + raw
            raise ValueError("RVA outside sections")

        cli = offset(struct.unpack_from("<I", d, datadirs + 14 * 8)[0])  # CLR runtime header
        res_rva, res_size = struct.unpack_from("<II", d, cli + 24)
        base, pos = offset(res_rva), 0
        while pos + 4 <= res_size:
            n = struct.unpack_from("<I", d, base + pos)[0]
            yield d[base + pos + 4:base + pos + 4 + n]
            pos = (pos + 4 + n + 7) & ~7

    def zips(self):
        """{"UI_bc1": path, "UI_bc1_xits": path} for whatever is available
        without network access."""
        if self._zips is not None:
            return self._zips
        found = {}
        for name in ("UI_bc1", "UI_bc1_xits"):
            loose = os.path.join(os.path.dirname(SCRIPT_DIR), name + ".zip")
            if os.path.isfile(loose):
                found[name] = loose
        exe = self.local_exe()
        if exe and len(found) < 2:
            try:
                with open(exe, "rb") as f:
                    data = f.read()
                outdir = os.path.join(CACHE_DIR, "bundle-" + hashlib.sha256(data).hexdigest()[:12])
                for blob in self._resources(data):
                    if not blob.startswith(b"PK\x03\x04"):
                        continue
                    path = os.path.join(outdir, "eui.zip.part")
                    os.makedirs(outdir, exist_ok=True)
                    with open(path, "wb") as f:
                        f.write(blob)
                    tops = zip_top_dirs(path)
                    if len(tops) == 1 and tops[0] in ("UI_bc1", "UI_bc1_xits") and tops[0] not in found:
                        final = os.path.join(outdir, tops[0] + ".zip")
                        os.replace(path, final)
                        found[tops[0]] = final
                    else:
                        os.unlink(path)
            except (OSError, ValueError, struct.error, zipfile.BadZipFile):
                pass
        self._zips = found
        return found

    def zip_for(self, folder, log=None):
        z = self.zips().get(folder)
        if z is None and not os.path.isfile(os.path.join(CACHE_DIR, "KekModInstaller.exe")):
            self.fetch_exe(log)
            z = self.zips().get(folder)
        return z


BUNDLE = Bundle()


