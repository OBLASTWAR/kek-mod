    def on_clear_gfx(self):
        if is_civ_running():
            self.msgbox("CLEAR GRAPHICS CACHES", "Civilization V is currently running. Close the game first, "
                        "then clear the caches.")
            return
        self.log("=== CLEAR GFX CACHE ===")
        results = clear_gfx_caches(self.game)
        for label, deleted, skipped in results:
            self.log("%s: %d deleted%s" % (label, deleted, ", %d in use/skipped" % skipped if skipped else ""))
        if not results:
            self.log("No shader caches found.")
        self.log("DONE. Caches rebuild automatically on next launch.")
        self.status = "GFX CACHES CLEARED."

    def on_redownload(self):
        if self.busy:
            return
        if is_civ_running():
            self.msgbox("REDOWNLOAD CIV", "Civilization V is currently running. Close the game first, then redownload it.")
            return
        try:
            path = validate_game_folder(self.game)
        except InstallerError as e:
            self.msgbox("REDOWNLOAD CIV", str(e), color="mag")
            return
        self.status = "MEASURING GAME FOLDER..."
        self.draw()
        size = dir_size(path)
        self.status = "SYSTEM READY"
        word = self.prompt("REDOWNLOAD CIV",
                           "Deletes the ENTIRE game folder:\n%s\n\nSteam then downloads it again (%s). Every mod "
                           "and EUI in it is removed. Saves and settings in the Proton prefix are kept.\n\n"
                           "Type DELETE to confirm:" % (path, format_size(size)),
                           confirm_word="DELETE", ok_label="REDOWNLOAD", color="mag")
        if word != "DELETE":
            return
        if is_civ_running():
            self.msgbox("REDOWNLOAD CIV", "Civilization V was started -- redownload cancelled.")
            return
        game = self.game

        def job(log, progress):
            log("=== REDOWNLOAD CIV ===")
            return "GAME FILES DELETED." if redownload_game(game, log, progress) else "DELETE INCOMPLETE -- SEE LOG"
        self.start_job("DELETING GAME FILES...", job)

    def on_verify(self):
        if self.busy:
            return
        self.status = "VERIFYING..."
        self.draw()
        self.refresh_state()
        checks = run_checks(self.game, self.state)
        extras = scan_extra_folders(self.game)
        self.status = "SYSTEM READY"
        self.verify_dialog(checks, extras)
        self.refresh_state()

    def verify_dialog(self, checks, extras):
        c = self.curses
        st = {"focus": 0, "top": 0, "btns": []}
        all_ok = all(ok for ok, _ in checks)

        def focusables():
            out = []
            for i in range(len(extras)):
                out += [("archive", i), ("delete", i)]
            return out + [("close", None)]

        def draw():
            h, _w = self.scr.getmaxyx()
            H = min(h - 2, len(checks) + max(1, len(extras)) + 11)
            y, x, W, H = self._dialog_frame("VERIFY MODS", 86, H, "mag")
            for i, (ok, msg) in enumerate(checks):
                self.put(y + 2 + i, x + 3, ("[OK] " if ok else "[!!] ") + msg, self.attr["mag"], maxw=W - 6)
            yy = y + 3 + len(checks)
            self.put(yy, x + 3, "Unrecognized folders in Assets/DLC + Assets/Maps. Leave a row alone to KEEP it.",
                     self.attr["mag"], maxw=W - 6)
            self.put(yy + 1, x + 3, "ARCHIVE = zip in place (undo: unzip).  DELETE = gone for good.",
                     self.attr["dim"], maxw=W - 6)
            list_y = yy + 2
            rows = max(1, H - (list_y - y) - 3)
            fl = focusables()
            cur = fl[st["focus"]] if st["focus"] < len(fl) else ("close", None)
            if cur[1] is not None:
                if cur[1] < st["top"]:
                    st["top"] = cur[1]
                if cur[1] >= st["top"] + rows:
                    st["top"] = cur[1] - rows + 1
            st["btns"] = []
            if not extras:
                self.put(list_y, x + 3, "Nothing here -- everything's been kept, archived, or deleted.", self.attr["dim"])
            for r in range(rows):
                i = st["top"] + r
                if i >= len(extras):
                    break
                e = extras[i]
                ry = list_y + r
                self.put(ry, x + 3, "[%s] " % e.where, self.attr["mag"])
                self.put(ry, x + 10, e.name, self.attr["mag"], maxw=W - 52)
                self.put(ry, x + W - 39, format_size(e.size).rjust(9), self.attr["dim"])
                for kind, label, bx, col in (("archive", "ARCHIVE", x + W - 28, "mag"), ("delete", "DELETE", x + W - 15, "mag")):
                    b = Btn((kind, i), label, None, True, col)
                    self.focus = cur
                    self.button(b, ry, bx, 12, st["btns"])
            if len(extras) > rows:
                self.put(list_y + rows, x + 3, "%d more -- scroll with the arrows" % (len(extras) - rows), self.attr["dim"])
            b = Btn(("close", None), "CLOSE", None, True, "mag")
            self.focus = cur
            self.button(b, y + H - 2, x + W - 12, 9, st["btns"])

        def act(target):
            kind, i = target
            if kind == "close":
                return (None,)
            e = extras[i]
            try:
                if kind == "archive":
                    zp = archive_folder(e)
                    self.log("Archived %s -> %s" % (e.name, zp))
                else:
                    if self.msgbox("CONFIRM DELETE", 'Permanently delete "%s"? This cannot be undone.' % e.name,
                                   ["DELETE", "CANCEL"], "mag", 1, 1) != 0:
                        return None
                    remove_tree(e.path)
                    self.log("Deleted " + e.name)
            except OSError as ex:
                self.msgbox("FAILED", "Couldn't %s %s: %s" % (kind, e.name, ex), color="mag")
                return None
            extras.pop(i)
            st["focus"] = min(st["focus"], len(focusables()) - 1)
            return None

        def key(k):
            fl = focusables()
            if k in (27, ord("q")):
                return (None,)
            if k in (10, 13, c.KEY_ENTER, ord(" ")):
                return act(fl[st["focus"]])
            if k == c.KEY_MOUSE:
                hit = self._hit(st["btns"])
                return act(hit.id) if hit else None
            if k in (c.KEY_RIGHT, 9, ord("l")):
                st["focus"] = (st["focus"] + 1) % len(fl)
            elif k in (c.KEY_LEFT, c.KEY_BTAB, ord("h")):
                st["focus"] = (st["focus"] - 1) % len(fl)
            elif k in (c.KEY_DOWN, ord("j")):
                st["focus"] = min(len(fl) - 1, st["focus"] + 2)
            elif k in (c.KEY_UP, ord("k")):
                st["focus"] = max(0, st["focus"] - 2)
            return None
        self._dialog_loop(draw, key)

    def on_settings(self):
        c = self.curses
        st = {"beta": self.settings.show_beta, "civ": self.settings.civ_dir, "focus": 0, "btns": []}
        items = ["beta", "civ", "auto", "ok", "cancel"]

        def draw():
            y, x, W, H = self._dialog_frame("SETTINGS", 72, 11, "mag")
            self.focus = items[st["focus"]]
            mark = "[X]" if st["beta"] else "[ ]"
            fa = self.attr["mag_inv"] if self.focus == "beta" else self.attr["mag"]
            self.put(y + 2, x + 3, mark + " Enable beta builds", fa)
            st["beta_row"] = y + 2
            self.put(y + 4, x + 3, "Civ V folder:", self.attr["mag"])
            self.put(y + 5, x + 5, tail(st["civ"], W - 8) if st["civ"] else "auto-detect (Steam libraries)",
                     self.attr["mag"])
            st["btns"] = []
            for bid, label, bx in (("civ", "CHANGE", x + 3), ("auto", "AUTO-DETECT", x + 14)):
                self.button(Btn(bid, label, None, True, "mag"), y + 6, bx, len(label) + 4, st["btns"])
            self.put(y + 7, x + 3, "settings file: " + tail(Settings.PATH, W - 21), self.attr["dim"])
            self.button(Btn("ok", "OK", None, True, "mag"), y + H - 2, x + W - 22, 6, st["btns"])
            self.button(Btn("cancel", "CANCEL", None, True, "mag"), y + H - 2, x + W - 14, 10, st["btns"])

        def act(item):
            if item == "beta":
                st["beta"] = not st["beta"]
            elif item == "civ":
                path = self.prompt("CIV V FOLDER", "Path to the Civ V install folder (.../steamapps/common/%s):"
                                   % CIV_FOLDER, st["civ"] or (self.game.root if self.game else ""))
                if path:
                    g = Game(os.path.expanduser(path))
                    if g.problem():
                        self.msgbox("CAN'T USE THAT FOLDER", g.problem(), color="mag")
                    else:
                        st["civ"] = g.root
            elif item == "auto":
                st["civ"] = None
            elif item == "ok":
                return ("ok",)
            elif item == "cancel":
                return (None,)
            return None

        def key(k):
            if k == 27:
                return (None,)
            if k in (10, 13, c.KEY_ENTER, ord(" ")):
                return act(items[st["focus"]])
            if k == c.KEY_MOUSE:
                try:
                    _i, mx, my, _z, _b = c.getmouse()
                except c.error:
                    return None
                if my == st.get("beta_row"):
                    return act("beta")
                hit = next((b for b in st["btns"] if b.y == my and b.x <= mx < b.x + b.w), None)
                return act(hit.id) if hit else None
            if k in (c.KEY_DOWN, c.KEY_RIGHT, 9, ord("j"), ord("l")):
                st["focus"] = (st["focus"] + 1) % len(items)
            elif k in (c.KEY_UP, c.KEY_LEFT, c.KEY_BTAB, ord("k"), ord("h")):
                st["focus"] = (st["focus"] - 1) % len(items)
            return None

        if self._dialog_loop(draw, key) == "ok":
            moved = st["civ"] != self.settings.civ_dir
            self.settings.show_beta = st["beta"]
            self.settings.civ_dir = st["civ"]
            self.settings.save()
            if moved:
                self.game = find_game(self.settings, None)
                self.log("game:   " + (self.game.root if self.game else "not found"))
            self.refresh_state()
            self.status = "SETTINGS SAVED."

    def on_self_update(self):
        if self.busy:
            return
        if self.msgbox("UPDATE INSTALLER", "Download installer v%s from GitHub and restart?" % self.latest_self,
                       ["UPDATE", "LATER"], "mag", 0, 1) != 0:
            return
        try:
            _v, data = fetch_latest_self()
            apply_self_update(data)
        except InstallerError as e:
            self.msgbox("UPDATE FAILED", str(e), color="mag")
            return
        self.curses.endwin()
        os.execv(sys.executable, [sys.executable, SCRIPT_PATH] + sys.argv[1:])


if __name__ == "__main__":
    sys.exit(main())
