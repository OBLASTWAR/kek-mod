def fetch_ticker():
    try:
        text = http_bytes(RAW_MAIN + "/installer/ticker.txt", timeout=15).decode("utf-8", "replace").strip()
        return " ".join(text.split()) or None
    except InstallerError:
        return None


def fetch_latest_self():
    """(version, script bytes) of the copy on main."""
    try:
        data = http_bytes(RAW_MAIN + "/" + SELF_REPO_PATH, timeout=30)
    except InstallerError as e:
        if "404" in str(e):
            raise InstallerError("No Linux installer is published on main yet.") from None
        raise
    m = re.search(rb'^VERSION = "([^"]+)"', data, re.M)
    if not m:
        raise InstallerError("Couldn't read the version of the installer on GitHub.")
    return m.group(1).decode(), data


def in_git_checkout():
    """True when this is the repo's own installer/linux/civ5-mod --
    not merely some file under a git work tree (e.g. a dotfiles repo in ~)."""
    root = os.path.dirname(os.path.dirname(SCRIPT_DIR))
    return (os.path.basename(SCRIPT_DIR) == "linux" and os.path.basename(os.path.dirname(SCRIPT_DIR)) == "installer"
            and os.path.exists(os.path.join(root, ".git")))


def apply_self_update(data):
    if in_git_checkout():
        raise InstallerError("This copy lives in a git checkout -- update it with `git pull` instead.")
    if not os.access(SCRIPT_DIR, os.W_OK):
        raise InstallerError("Can't write to %s -- if a package manager installed this, update it there." % SCRIPT_DIR)
    tmp = SCRIPT_PATH + ".new"
    with open(tmp, "wb") as f:
        f.write(data)
    os.chmod(tmp, os.stat(SCRIPT_PATH).st_mode)
    os.replace(tmp, SCRIPT_PATH)
    # The cached EUI bundle tracks main too -- refresh it alongside.
    try:
        os.unlink(os.path.join(CACHE_DIR, "KekModInstaller.exe"))
    except OSError:
        pass


# ── Installing this program onto the machine ──────────────────────────────────
# The one-liner pipes this file into `python3 - install-self`, which puts a
# copy in ~/.local/bin (the per-user bin folder most distros already have on
# PATH), makes sure it IS on PATH, and adds an app-menu entry -- after that
# players just type `civ5-mod`. Self-update keeps that copy current.

APP_CMD = "civ5-mod"
BIN_DIR = os.path.expanduser("~/.local/bin")
INSTALLED_PATH = os.path.join(BIN_DIR, APP_CMD)
DESKTOP_PATH = os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share"),
                            "applications", APP_CMD + ".desktop")
RC_MARKER = "# added by " + APP_CMD
PATH_LINE = 'export PATH="$HOME/.local/bin:$PATH"  ' + RC_MARKER
FISH_CONF = os.path.expanduser("~/.config/fish/conf.d/%s.fish" % APP_CMD)


def _shell_rc_files():
    """Startup files to put PATH_LINE in: ~/.bashrc always (bash is the login
    shell on SteamOS, Fedora, Ubuntu...), ~/.zshrc when zsh is in use."""
    files = [os.path.expanduser("~/.bashrc")]
    if os.path.exists(os.path.expanduser("~/.zshrc")) or os.environ.get("SHELL", "").endswith("zsh"):
        files.append(os.path.expanduser("~/.zshrc"))
    return files


def _on_path(folder):
    return any(os.path.realpath(p) == os.path.realpath(folder)
               for p in os.environ.get("PATH", "").split(os.pathsep) if p)


def install_self(log):
    """Returns True when the current shell already finds `civ5-mod`."""
    data = None
    if os.path.isfile(SCRIPT_PATH):
        with open(SCRIPT_PATH, "rb") as f:
            data = f.read()
    if not data or b'\nVERSION = "' not in data:
        log("Downloading the installer from GitHub...")  # piped in: there's no file to copy
        data = fetch_latest_self()[1]
    os.makedirs(BIN_DIR, exist_ok=True)
    if os.path.realpath(SCRIPT_PATH) != os.path.realpath(INSTALLED_PATH):
        tmp = INSTALLED_PATH + ".new"
        with open(tmp, "wb") as f:
            f.write(data)
        os.chmod(tmp, 0o755)
        os.replace(tmp, INSTALLED_PATH)
    log("Installed " + INSTALLED_PATH)

    os.makedirs(os.path.dirname(DESKTOP_PATH), exist_ok=True)
    with open(DESKTOP_PATH, "w") as f:
        f.write("[Desktop Entry]\nType=Application\nName=Civ V Mod Installer\n"
                "Comment=Install KEK Mod, Tournament Mod, Lekmod and EUI for Civilization V (Proton)\n"
                'Exec="%s"\nTerminal=true\nIcon=applications-games\nCategories=Game;\n' % INSTALLED_PATH)
    log("Added 'Civ V Mod Installer' to the app menu")

    if _on_path(BIN_DIR):
        return True
    for rc in _shell_rc_files():
        try:
            with open(rc) as f:
                if RC_MARKER in f.read():
                    continue
        except OSError:
            pass
        with open(rc, "a") as f:
            f.write("\n" + PATH_LINE + "\n")
        log("Added ~/.local/bin to PATH in " + rc.replace(os.path.expanduser("~"), "~"))
    if os.path.isdir(os.path.dirname(FISH_CONF)):
        with open(FISH_CONF, "w") as f:
            f.write("fish_add_path -g $HOME/.local/bin  %s\n" % RC_MARKER)
        log("Added ~/.local/bin to PATH for fish")
    return False


def uninstall_self(log):
    """Removes the program, its menu entry, PATH lines, settings and cache.
    Mods installed into the game are left alone."""
    for path in (INSTALLED_PATH, DESKTOP_PATH, FISH_CONF):
        if os.path.isfile(path):
            os.unlink(path)
            log("Removed " + path)
    for rc in _shell_rc_files():
        try:
            with open(rc) as f:
                lines = f.read().split("\n")
        except OSError:
            continue
        kept = []
        for l in lines:
            if RC_MARKER in l:
                if kept and kept[-1] == "":
                    kept.pop()  # the blank line install_self put before it
                continue
            kept.append(l)
        if len(kept) != len(lines):
            with open(rc, "w") as f:
                f.write("\n".join(kept))
            log("Removed the PATH line from " + rc.replace(os.path.expanduser("~"), "~"))
    for d in (CONFIG_DIR, CACHE_DIR):
        if os.path.isdir(d):
            shutil.rmtree(d, ignore_errors=True)
            log("Removed " + d)


