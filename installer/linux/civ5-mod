class Settings:
    PATH = os.path.join(CONFIG_DIR, "settings.json")

    def __init__(self):
        self.show_beta = False
        self.civ_dir = None
        try:
            with open(self.PATH) as f:
                data = json.load(f)
            self.show_beta = bool(data.get("show_beta", False))
            self.civ_dir = data.get("civ_dir") or None
        except (OSError, ValueError):
            pass

    def save(self):
        os.makedirs(CONFIG_DIR, exist_ok=True)
        tmp = self.PATH + ".tmp"
        with open(tmp, "w") as f:
            json.dump({"show_beta": self.show_beta, "civ_dir": self.civ_dir}, f, indent=2)
        os.replace(tmp, self.PATH)


# ── HTTP ──────────────────────────────────────────────────────────────────────

def _request(url, accept=None):
    req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    if accept:
        req.add_header("Accept", accept)
    token = os.environ.get("GITHUB_TOKEN")
    if token and urllib.parse.urlparse(url).hostname == "api.github.com":
        req.add_header("Authorization", "Bearer " + token)
    return req


def _describe_http_error(e, url):
    # Same idea as GitHubModSource.DescribeError: the anonymous rate limit is
    # by far the most common failure, and the bare status code says nothing.
    host = urllib.parse.urlparse(url).hostname
    if e.code in (403, 429) and e.headers.get("X-RateLimit-Remaining") == "0":
        note = ""
        reset = e.headers.get("X-RateLimit-Reset")
        if reset and reset.isdigit():
            note = " Try again after %s." % time.strftime("%H:%M", time.localtime(int(reset)))
        return ("GitHub API rate limit reached (60 requests/hour without signing in)." + note
                + " Setting GITHUB_TOKEN raises the limit.")
    if e.code == 404:
        return "Not found (404): " + url
    return "%s returned %d %s." % (host, e.code, e.reason)


def http_open(url, accept=None, opener=None, timeout=60):
    try:
        return (opener or urllib.request.build_opener()).open(_request(url, accept), timeout=timeout)
    except urllib.error.HTTPError as e:
        raise InstallerError(_describe_http_error(e, url)) from None
    except (urllib.error.URLError, OSError) as e:
        reason = getattr(e, "reason", e)
        raise InstallerError("Couldn't reach %s (%s)." % (urllib.parse.urlparse(url).hostname, reason)) from None


def http_bytes(url, accept=None, timeout=60):
    with http_open(url, accept, timeout=timeout) as r:
        return r.read()


def github_api(path):
    data = http_bytes("https://api.github.com/" + path, accept="application/vnd.github+json")
    return json.loads(data.decode("utf-8"))


def download_to(url, dest, progress=None, opener=None):
    """Streams url into dest. Returns the response's media type; for a
    text/html response nothing is written (Google Drive's interstitial)."""
    with http_open(url, opener=opener, timeout=120) as r:
        ctype = r.headers.get_content_type()
        if ctype == "text/html":
            return ctype
        total = int(r.headers.get("Content-Length") or 0)
        done = 0
        with open(dest, "wb") as out:
            while True:
                chunk = r.read(1 << 16)
                if not chunk:
                    break
                out.write(chunk)
                done += len(chunk)
                if progress and total:
                    progress(min(1.0, done / total))
        return ctype


# ── Versions ──────────────────────────────────────────────────────────────────

def version_key(raw):
    """"v34.15" / "5.2b" -> comparable key. Unparseable sorts lowest, the
    same fallback LekmodModSource/TournamentMapExtra use."""
    s = raw[1:] if raw[:1] in ("v", "V") else raw
    m = re.match(r"^(\d+(?:\.\d+)*)([a-zA-Z]*)$", s or "")
    if not m:
        return (0, (), raw)
    nums = [int(x) for x in m.group(1).split(".")]
    while len(nums) > 1 and nums[-1] == 0:
        nums.pop()
    return (1, tuple(nums), m.group(2))


def is_newer_version(remote, local):
    # Plain dotted numbers compare numerically; anything else falls back to
    # "different means newer" like InstallerCore.IsNewerVersion.
    if re.match(r"^\d+(\.\d+)*$", remote) and re.match(r"^\d+(\.\d+)*$", local):
        return version_key(remote) > version_key(local)
    return remote.lower() != local.lower()


# ── Filesystem helpers ────────────────────────────────────────────────────────
# Windows resolves paths case-insensitively and every script/zip we deal with
# was written for that, so lookups go through ci_resolve.

def ci_resolve(path):
    """path, with each component matched case-insensitively against what's on
    disk. Components that don't exist are kept as given."""
    if os.path.lexists(path):
        return path
    parent, name = os.path.split(path)
    if not name or parent == path:
        return path
    parent = ci_resolve(parent)
    try:
        lname = name.lower()
        for entry in os.listdir(parent):
            if entry.lower() == lname:
                return os.path.join(parent, entry)
    except OSError:
        pass
    return os.path.join(parent, name)


def ci_dirs_with_prefix(root, prefix):
    """Subfolders of root whose names start with prefix, ignoring case (the
    Directory.GetDirectories(root, "<prefix>*") equivalent)."""
    try:
        names = sorted(os.listdir(root))
    except OSError:
        return []
    lp = prefix.lower()
    return [os.path.join(root, n) for n in names
            if n.lower().startswith(lp) and os.path.isdir(os.path.join(root, n))
            and not os.path.islink(os.path.join(root, n))]


def remove_tree(path):
    if os.path.islink(path) or os.path.isfile(path):
        os.unlink(path)
    elif os.path.isdir(path):
        shutil.rmtree(path)


def dir_size(root):
    total = 0
    for dirpath, _dirs, files in os.walk(root):
        for f in files:
            try:
                total += os.lstat(os.path.join(dirpath, f)).st_size
            except OSError:
                pass
    return total


def format_size(n):
    if n >= 1 << 30:
        return "%.1f GB" % (n / float(1 << 30))
    if n >= 1 << 20:
        return "%.1f MB" % (n / float(1 << 20))
    return "%d KB" % (n // 1024)


def extract_zip(zip_path, dest_root):
    # Release zips made with PowerShell's Compress-Archive store paths with
    # backslashes; turn those into real folders instead of files named
    # "KEK Mod v2.0\Art\x.dds". Also refuses entries escaping dest_root.
    dest_root = os.path.realpath(dest_root)
    with zipfile.ZipFile(zip_path) as zf:
        for info in zf.infolist():
            rel = info.filename.replace("\\", "/").lstrip("/")
            if not rel:
                continue
            dest = os.path.realpath(os.path.join(dest_root, rel))
            if dest != dest_root and not dest.startswith(dest_root + os.sep):
                raise InstallerError("Refusing to extract outside the target folder: " + info.filename)
            if rel.endswith("/"):
                os.makedirs(dest, exist_ok=True)
                continue
            os.makedirs(os.path.dirname(dest), exist_ok=True)
            with zf.open(info) as src, open(dest, "wb") as out:
                shutil.copyfileobj(src, out)


def zip_top_dirs(zip_path):
    with zipfile.ZipFile(zip_path) as zf:
        return sorted({n.replace("\\", "/").lstrip("/").split("/")[0] for n in zf.namelist()} - {""})


def open_in_desktop(target):
    """xdg-open (folders, steam:// URLs), falling back to `steam <url>` for
    steam:// links. False if nothing could take it."""
    cmds = [["xdg-open", target]]
    if target.startswith("steam://"):
        cmds.append(["steam", target])
    for cmd in cmds:
        if shutil.which(cmd[0]):
            try:
                subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                 stderr=subprocess.DEVNULL, start_new_session=True)
                return True
            except OSError:
                continue
    return False


# ── Finding the game ──────────────────────────────────────────────────────────

def steam_roots():
    home = os.path.expanduser("~")
    return [os.path.join(home, p) for p in (
        ".local/share/Steam",
        ".steam/steam",
        ".steam/root",
        ".var/app/com.valvesoftware.Steam/.local/share/Steam",
        "snap/steam/common/.local/share/Steam",
    )]


def steam_libraries():
    """Every Steam library folder (the dirs holding steamapps/), main install
    first, de-duplicated across the symlinked Steam roots."""
    seen, out = set(), []

    def add(path):
        real = os.path.realpath(path)
        if real not in seen and os.path.isdir(os.path.join(real, "steamapps")):
            seen.add(real)
            out.append(real)

    for root in steam_roots():
        if not os.path.isdir(os.path.join(root, "steamapps")):
            continue
        add(root)
        for vdf in (os.path.join(root, "steamapps", "libraryfolders.vdf"),
                    os.path.join(root, "config", "libraryfolders.vdf")):
            try:
                with open(vdf, encoding="utf-8", errors="replace") as f:
                    for m in re.finditer(r'"path"\s*"([^"]+)"', f.read()):
                        add(m.group(1).replace("\\\\", "\\"))
            except OSError:
                pass
    return out


class Game:
    """One Civ V install plus everything derived from it: Assets/DLC,
    Assets/Maps, and the Proton prefix that holds its Documents folder."""

    def __init__(self, root):
        self.root = os.path.realpath(root)
        self.assets = ci_resolve(os.path.join(self.root, "Assets"))
        self.dlc = ci_resolve(os.path.join(self.assets, "DLC"))
        self.maps = ci_resolve(os.path.join(self.assets, "Maps"))
        parent = os.path.dirname(self.root)
        grand = os.path.dirname(parent)
        self.steamapps = grand if (os.path.basename(parent).lower() == "common"
                                   and os.path.basename(grand).lower() == "steamapps") else None
        self.prefix = self._find_prefix()
        self.docs = None
        if self.prefix:
            self.docs = ci_resolve(os.path.join(self.prefix, "drive_c", "users", "steamuser", "Documents",
                                                "My Games", CIV_DOCS_FOLDER))

    def _find_prefix(self):
        # compatdata normally sits in the same library as the game, but Steam
        # can keep it in the main library instead.
        candidates = []
        if self.steamapps:
            candidates.append(self.steamapps)
        candidates += [os.path.join(lib, "steamapps") for lib in steam_libraries()]
        for sa in candidates:
            pfx = os.path.join(sa, "compatdata", CIV_APPID, "pfx")
            if os.path.isdir(pfx):
                return pfx
        return None

    def problem(self):
        """None when mods can be installed here, else why not."""
        if not os.path.isdir(self.root):
            return "%s doesn't exist." % self.root
        has_exe = any(os.path.isfile(os.path.join(self.root, n))
                      for n in ("CivilizationV_DX11.exe", "CivilizationV.exe"))
        if not has_exe or not os.path.isdir(self.dlc):
            return ("%s is the native Linux build of Civ V. KEK Mod replaces a Windows DLL, so it needs "
                    "the Windows build: in Steam, Civ V > Properties > Compatibility > force a Proton "
                    "version, let Steam finish updating, launch the game once, then come back here."
                    % self.root)
        return None


def find_game(settings, override=None):
    path = override or settings.civ_dir
    if path:
        return Game(os.path.expanduser(path))
    for lib in steam_libraries():
        candidate = os.path.join(lib, "steamapps", "common", CIV_FOLDER)
        if os.path.isdir(candidate):
            return Game(candidate)
    return None


# ── Civ V processes ───────────────────────────────────────────────────────────
# Under Proton the game shows up as a Wine process whose argv[0] is the
# Windows exe path, and whose comm is the exe name cut to 15 characters.

def _civ_pids():
    exe_names = {n.lower() + ".exe" for n in CIV_PROCESS_NAMES}
    comms = {(n + ".exe")[:15].lower() for n in CIV_PROCESS_NAMES}
    pids = []
    for entry in os.listdir("/proc"):
        if not entry.isdigit():
            continue
        try:
            with open("/proc/%s/cmdline" % entry, "rb") as f:
                argv0 = f.read().split(b"\0", 1)[0].decode("utf-8", "replace")
            with open("/proc/%s/comm" % entry) as f:
                comm = f.read().strip().lower()
        except OSError:
            continue
        base = re.split(r"[\\/]", argv0)[-1].lower()
        if base in exe_names or comm in comms:
            pids.append(int(entry))
    return pids


def is_civ_running():
    return bool(_civ_pids())


def force_close_civ():
    """Kills the game outright (SIGKILL) -- unsaved progress is lost, callers
    confirm first."""
    pids = _civ_pids()
    for pid in pids:
        try:
            os.kill(pid, signal.SIGKILL)
        except OSError:
            pass
    deadline = time.time() + 5
    while time.time() < deadline and _civ_pids():
        time.sleep(0.1)
    return len(pids)


# ── Mod sources ───────────────────────────────────────────────────────────────

class Release:
    def __init__(self, tag, prerelease=False, extra=None, native=None):
        self.tag = tag
        self.prerelease = prerelease
        self.extra = extra    # extra text for version lists, e.g. Lekmod's date/size
        self.native = native  # source-specific payload used to download it


class GitHubSource:
    """GitHub Releases, one asset per release (GitHubModSource.cs)."""

    def __init__(self, owner, repo, supports_beta):
        self.owner, self.repo, self.supports_beta = owner, repo, supports_beta

    def _fetch(self):
        rels = github_api("repos/%s/%s/releases?per_page=50" % (self.owner, self.repo))
        if not rels:
            raise InstallerError("No releases found for %s/%s." % (self.owner, self.repo))
        return rels

    def _latest(self):
        try:
            return github_api("repos/%s/%s/releases/latest" % (self.owner, self.repo))
        except InstallerError as e:
            if "404" in str(e):
                raise InstallerError('No "Latest" release found for %s/%s.' % (self.owner, self.repo)) from None
            raise

    @staticmethod
    def _to_release(r):
        return Release(r["tag_name"], bool(r.get("prerelease")), None, r)

    def list_releases(self):
        rels = self._fetch()
        if not self.supports_beta:
            # catscats doesn't publish in order -- trust GitHub's own Latest
            # flag over list order (see GitHubModSource.MoveLatestToFront).
            try:
                latest = self._latest()
                idx = next((i for i, r in enumerate(rels) if r["tag_name"].lower() == latest["tag_name"].lower()), -1)
                if idx > 0:
                    rels.insert(0, rels.pop(idx))
            except InstallerError:
                pass
        return [self._to_release(r) for r in rels]

    def resolve(self, tag, want_beta):
        if tag:
            for r in self._fetch():
                if r["tag_name"].lower() == tag.lower():
                    return self._to_release(r)
            raise InstallerError("Release %s doesn't exist on GitHub. Pick another version." % tag)
        if not self.supports_beta:
            return self._to_release(self._latest())
        rels = self._fetch()
        chosen = rels[0] if want_beta else next((r for r in rels if not r.get("prerelease")), None)
        if chosen is None:
            raise InstallerError("No stable release found. Enable beta builds to install the latest beta.")
        return self._to_release(chosen)

    def download(self, release, dest_dir, log, progress):
        assets = release.native.get("assets") or []
        if not assets:
            raise InstallerError("Release %s has no assets." % release.tag)
        asset = assets[0]
        log("Asset: " + asset["name"])
        path = os.path.join(dest_dir, "release.zip")
        download_to(asset["browser_download_url"], path, progress)
        return path


class LekmodSource:
    """Lekmod's versions.json manifest + Google Drive files (LekmodModSource.cs)."""

    MANIFEST = "https://raw.githubusercontent.com/EnormousApplePie/Lekmod/main/LekmodInstaller/github_setup/versions.json"
    supports_beta = False

    def _manifest(self):
        # Cache-buster: raw.githubusercontent.com can serve a stale copy for minutes.
        data = json.loads(http_bytes(self.MANIFEST + "?t=%d" % int(time.time())).decode("utf-8"))
        out = []
        for tag, entry in data.items():
            if isinstance(entry, dict) and entry.get("file_id"):
                extra = ", ".join(x for x in (entry.get("release_date"), entry.get("size")) if x) or None
                out.append(Release(tag, False, extra, entry))
        out.sort(key=lambda r: version_key(r.tag), reverse=True)
        return out

    def list_releases(self):
        return self._manifest()

    def resolve(self, tag, want_beta):
        rels = self._manifest()
        if not rels:
            raise InstallerError("No Lekmod versions found in the online manifest.")
        if tag:
            for r in rels:
                if r.tag.lower() == tag.lower():
                    return r
            raise InstallerError("Lekmod %s isn't in the online manifest. Pick another version." % tag)
        return rels[0]

    def download(self, release, dest_dir, log, progress):
        # Same fallback chain as Lekmod's own installer: plain link, then the
        # confirm-token cookie, then drive.usercontent.google.com with
        # confirm=t for files past the virus-scan size limit.
        file_id = release.native["file_id"]
        size = release.native.get("size")
        log("Google Drive file: " + file_id + (" (%s)" % size if size else ""))
        jar = http.cookiejar.CookieJar()
        opener = urllib.request.build_opener(urllib.request.HTTPCookieProcessor(jar))
        path = os.path.join(dest_dir, "release.zip")
        url = "https://drive.google.com/uc?export=download&id=" + file_id
        if download_to(url, path, progress, opener) != "text/html":
            return path
        token = next((c.value for c in jar if "download_warning" in c.name.lower() or "confirm" in c.name.lower()), None)
        if token:
            if download_to(url + "&confirm=" + token, path, progress, opener) != "text/html":
                return path
        log("Large file, bypassing Google Drive's virus-scan page...")
        url = "https://drive.usercontent.google.com/download?id=%s&export=download&confirm=t" % file_id
        if download_to(url, path, progress, opener) != "text/html":
            return path
        raise InstallerError("Google Drive returned a web page instead of the file. It may no longer be "
                             "shared publicly, or its download quota is used up for today.")


# ── Bonus maps ────────────────────────────────────────────────────────────────
# Each is best-effort and "install once, never auto-update", exactly like the
# Windows extras: a failure is logged and never fails the mod install.

class FishMapExtra:
    id = "fishmapscript"
    name = "Fish Map Script"
    folder = "Fish Map Script"

    def _dir(self, game):
        return ci_resolve(os.path.join(game.maps, self.folder))

    def detect(self, game):
        d = self._dir(game)
        if not os.path.isdir(d):
            return None
        for f in sorted(os.listdir(d)):
            m = re.search(r"(\d+(?:\.\d+)*)\.modinfo$", f, re.I)
            if m:
                return "v" + m.group(1)
        return ""

    def ensure(self, game, log):
        try:
            if os.path.isdir(self._dir(game)):
