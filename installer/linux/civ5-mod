def eui_exact_match(game, variant):
    """True when every file of the bundled copy is on disk byte-for-byte; None
    when there's no bundled copy to compare with (offline, nothing cached)."""
    zp = BUNDLE.zips().get(variant.folder)
    if zp is None:
        return None
    target = ci_resolve(os.path.join(game.dlc, variant.folder))
    if not os.path.isdir(target):
        return False
    try:
        with zipfile.ZipFile(zp) as zf:
            for info in zf.infolist():
                name = info.filename.replace("\\", "/")
                if name.endswith("/"):
                    continue
                rel = name.split("/", 1)[1] if "/" in name else name
                disk = ci_resolve(os.path.join(target, rel))
                if not os.path.isfile(disk):
                    return False
                h = hashlib.sha256()
                with open(disk, "rb") as f:
                    for chunk in iter(lambda: f.read(1 << 16), b""):
                        h.update(chunk)
                if h.digest() != hashlib.sha256(zf.read(info)).digest():
                    return False
        return True
    except (OSError, zipfile.BadZipFile):
        return False


