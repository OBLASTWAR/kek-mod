# ── Lobby patch (LobbyPatchExtra.cs) ──────────────────────────────────────────
# civ5-lobby-patch: a proxy steam_api.dll in the game root that hooks
# SteamMatchmaking to drop Steam's lobby distance filter, forwarding every
# other export to the game's own DLL, renamed steam_api_orig.dll. The game's
# steam_api.dll is a Windows DLL under Proton too, so the same proxy works.
# "Installed" = the backup exists and differs from steam_api.dll (Steam's
# verify restores the stock DLL and leaves the backup -- then they're equal).

LOBBY_OWNER, LOBBY_REPO = "OBLASTWAR", "civ5-lobby-patch"
LOBBY_NAME = "Lobby Patch"
LOBBY_ASSET = "steam_api.dll"
LOBBY_ORIG = "steam_api_orig.dll"
LOBBY_MARKER = "civ5-lobby-patch.txt"  # installed release tag


def _lobby_paths(game):
    return (ci_resolve(os.path.join(game.root, LOBBY_ASSET)),
            ci_resolve(os.path.join(game.root, LOBBY_ORIG)),
            ci_resolve(os.path.join(game.root, LOBBY_MARKER)))


def _files_equal(a, b):
    if os.path.getsize(a) != os.path.getsize(b):
        return False
    with open(a, "rb") as fa, open(b, "rb") as fb:
        return fa.read() == fb.read()


def lobby_detect(game):
    """None when not installed, else the installed tag ("" if unknown)."""
    active, orig, marker = _lobby_paths(game)
    if not (os.path.isfile(active) and os.path.isfile(orig)) or _files_equal(active, orig):
        return None
    try:
        with open(marker, encoding="utf-8") as f:
            return f.read().strip()
    except OSError:
        return ""


def lobby_latest_tag():
    return GitHubSource(LOBBY_OWNER, LOBBY_REPO, False)._latest()["tag_name"]


def lobby_install(game, log, progress=lambda p: None):
    active, orig, marker = _lobby_paths(game)
    log("Checking %s/%s for the latest release..." % (LOBBY_OWNER, LOBBY_REPO))
    rel = GitHubSource(LOBBY_OWNER, LOBBY_REPO, False)._latest()
    asset = next((a for a in rel.get("assets") or [] if a["name"].lower() == LOBBY_ASSET), None)
    if asset is None:
        raise InstallerError("Release %s has no %s." % (rel["tag_name"], LOBBY_ASSET))
    log("Release: " + rel["tag_name"])
    log("Downloading %s..." % asset["name"])
    progress(10)
    with tempfile.TemporaryDirectory(prefix="civ5-mod-") as tmp:
        dl = os.path.join(tmp, LOBBY_ASSET)
        download_to(asset["browser_download_url"], dl, lambda f: progress(10 + int(60 * f)))
        with open(dl, "rb") as f:
            if f.read(2) != b"MZ":
                raise InstallerError("Downloaded %s isn't a Windows DLL." % asset["name"])
        # Back up the game's own DLL exactly once; with a backup in place,
        # steam_api.dll is an older proxy or Steam's restored stock copy.
        if not os.path.isfile(orig):
            if not os.path.isfile(active):
                raise InstallerError("%s not found in the game folder -- verify Civ V's files in Steam first."
                                     % LOBBY_ASSET)
            if os.path.isfile(marker):
                # Our marker but no backup: steam_api.dll is probably the
                # proxy, which would then load itself as _orig.
                raise InstallerError("%s is missing. Verify Civ V's files in Steam, then install again." % LOBBY_ORIG)
            log("Backing up %s -> %s" % (LOBBY_ASSET, LOBBY_ORIG))
            os.rename(active, orig)
        log("Installing %s..." % LOBBY_ASSET)
        shutil.copyfile(dl, active)
    with open(marker, "w", encoding="utf-8") as f:
        f.write(rel["tag_name"])
    progress(100)
    log("DONE: %s %s installed." % (LOBBY_NAME, rel["tag_name"]))


def lobby_remove(game, log, progress=lambda p: None):
    active, orig, marker = _lobby_paths(game)
    if not os.path.isfile(orig):
        log("No %s backup -- nothing to restore." % LOBBY_ORIG)
    else:
        log("Restoring the game's own %s..." % LOBBY_ASSET)
        os.replace(orig, active)
    if os.path.isfile(marker):
        os.remove(marker)
    progress(100)
    log("DONE: %s removed." % LOBBY_NAME)


# ── ui_check.bat ──────────────────────────────────────────────────────────────

class _BatchExit(Exception):
    pass


class BatchScript:
    """Runs a mod's ui_check.bat without Windows.

    Supports exactly what the shipped scripts (kek-mod, Tournament Mod,
    Lekmod) use: @echo off, rem, pushd "%~dp0", cd, set, for %%I in ("%cd%")
    do set "x=%%~nxI", del, copy, xcopy, echo text> file, IF [NOT] EXIST,
    FIND/FINDSTR ... && ( ) || ( ), exit, and Lekmod's one PowerShell
    $env:VAR .Replace('a','b'). Anything else is reported, not guessed at.

    Sandboxed: nothing outside the DLC folder (the script's parent) is ever
    written or deleted."""

    IF_RE = re.compile(r'^if\s+(not\s+)?exist\s+("[^"]*"|\S+)\s*(.*)$', re.I)
    FIND_RE = re.compile(r'^(find|findstr)\b(.*?)&&\s*\($', re.I)
    FOR_NXI_RE = re.compile(r'^for\s+%%(\w)\s+in\s+\("%cd%"\)\s+do\s+set\s+"(\w+)=%%~nx\1"$', re.I)
    PS_REPLACE_RE = re.compile(r"\$env:(\w+).*?\.Replace\('((?:[^']|'')*)'\s*,\s*'((?:[^']|'')*)'\)", re.I)

    def __init__(self, path):
        self.path = os.path.abspath(path)
        self.dir = os.path.dirname(self.path)
        self.sandbox = os.path.dirname(self.dir)
        self.cwd = self.dir
        self.vars = {}
        self.copied = 0
        self.failures = []
        self.unsupported = []

    def run(self):
        with open(self.path, "rb") as f:
            text = f.read().decode("latin-1")
        lines = [l.strip() for l in text.replace("\r\n", "\n").replace("\r", "\n").split("\n")]
        nodes, _i, _t = self._parse(lines, 0, True)
        try:
            self._exec(nodes)
        except _BatchExit:
            pass
        return self

    # parsing -- a flat list of ("cmd", lineno, text) and
    # ("if", cond, then_nodes, else_nodes) nodes
    def _parse(self, lines, i, top):
        nodes = []
        while i < len(lines):
            line, lineno = lines[i], i + 1
            i += 1
            low = line.lower()
            if not line or low == "rem" or low.startswith("rem ") or line.startswith("::"):
                continue
            if line.startswith(")"):
                if top:
                    raise InstallerError("ui_check.bat line %d: unmatched ')'" % lineno)
                return nodes, i, line
            m = self.IF_RE.match(line)
            if m:
                cond = ("exist", m.group(2), bool(m.group(1)))
                if m.group(3) == "(":
                    then, i, term = self._parse(lines, i, False)
                    els = []
                    if re.match(r"^\)\s*else\s*\($", term, re.I):
                        els, i, term = self._parse(lines, i, False)
                    nodes.append(("if", cond, then, els))
                else:
                    nodes.append(("if", cond, [("cmd", lineno, m.group(3))], []))
                continue
            m = self.FIND_RE.match(line)
            if m:
                then, i, term = self._parse(lines, i, False)
                els = []
                if re.match(r"^\)\s*\|\|\s*\($", term):
                    els, i, term = self._parse(lines, i, False)
                nodes.append(("if", ("find", line[:line.rindex("&&")], lineno), then, els))
                continue
            nodes.append(("cmd", lineno, line))
        if not top:
            raise InstallerError("ui_check.bat: unterminated '(' block")
        return nodes, i, None

    def _exec(self, nodes):
        for n in nodes:
            if n[0] == "if":
                self._exec(n[2] if self._cond(n[1]) else n[3])
            else:
                self._cmd(n[1], n[2])

    # helpers
    def _expand(self, s):
        s = re.sub(r"%~dp0", lambda m: self.dir + "/", s, flags=re.I)

        def var(m):
            name = m.group(1).lower()
            return self.cwd if name == "cd" else self.vars.get(name, "")
        return re.sub(r"%([A-Za-z_][A-Za-z0-9_]*)%", var, s)

    def _path(self, raw):
        p = raw.strip().strip('"').replace("\\", "/")
        if not os.path.isabs(p):
            p = os.path.join(self.cwd, p)
        return ci_resolve(os.path.normpath(p))

    def _inside(self, path):
        real = os.path.realpath(path)
        return real == self.sandbox or real.startswith(self.sandbox + os.sep)

    @staticmethod
    def _tokens(s):
        return re.findall(r'/C:"[^"]*"|"[^"]*"|\S+', s, re.I)

    @staticmethod
    def _drop_redirects(tokens):
        out, skip = [], False
        for t in tokens:
            if skip:
                skip = False
                continue
            if t in (">", "1>", "2>"):
                skip = True
            elif re.match(r"^\d?>(&\d|nul)?$", t, re.I):
                continue
            else:
                out.append(t)
        return out

    def _cond(self, cond):
        if cond[0] == "exist":
            return os.path.exists(self._path(self._expand(cond[1]))) != cond[2]
        tokens = self._drop_redirects(self._tokens(self._expand(cond[1])))
        verb, args = tokens[0].lower(), tokens[1:]
        ignore_case = any(a.lower() == "/i" for a in args)
        needle, files = None, []
        for a in args:
            if a.upper().startswith("/C:"):
                needle = a[3:].strip('"')
            elif a.startswith("/"):
                continue
            elif needle is None and verb == "find":
                needle = a.strip('"')
            else:
                files.append(a)
        if needle is None or not files:
            self.unsupported.append("line %d: %s" % (cond[2], cond[1]))
            return False
        for f in files:
            try:
                with open(self._path(f), "rb") as fh:
                    hay = fh.read().decode("latin-1")
            except OSError:
                continue
            if (needle.lower() in hay.lower()) if ignore_case else (needle in hay):
                return True
        return False

    def _cmd(self, lineno, raw):
        m = self.FOR_NXI_RE.match(raw)
        if m:
            self.vars[m.group(2).lower()] = os.path.basename(self.cwd)
            return
        line = self._expand(raw).strip().lstrip("@").strip()
        low = line.lower()
        if low in ("echo off", "echo on", "cls", "popd", "setlocal", "endlocal") or low.startswith("title "):
            return
        if low == "exit" or low.startswith("exit "):
            raise _BatchExit()
        m = re.match(r"^echo\s+\w\s*\|\s*(.*)$", line, re.I)  # "ECHO F | xcopy", "ECHO Y | del"
        if m:
            line = m.group(1)
            low = line.lower()
        m = re.match(r'^echo\s(.*?)\s*>\s*("[^"]*"|\S+)\s*$', line, re.I)
        if m and m.group(2).lower() != "nul":
            target = self._path(m.group(2))
            if not self._inside(target):
                self.failures.append("line %d: write outside DLC refused" % lineno)
                return
            os.makedirs(os.path.dirname(target), exist_ok=True)
            with open(target, "wb") as f:
                f.write(m.group(1).encode("latin-1") + b"\r\n")
            return
        if low == "echo" or low.startswith(("echo ", "echo.")):
            return  # console output only
        verb = low.split(None, 1)[0] if low else ""
        rest = line[len(verb):].strip()
        if verb in ("pushd", "cd", "chdir"):
            target = self._path(rest or ".")
            if os.path.isdir(target):
                self.cwd = target
            else:
                self.failures.append("line %d: no such folder %s" % (lineno, target))
        elif verb == "set":
            body = rest[1:-1] if rest.startswith('"') and rest.endswith('"') else rest
            if "=" in body:
                k, v = body.split("=", 1)
                self.vars[k.strip().lower()] = v
        elif verb in ("del", "erase"):
            for t in self._drop_redirects(self._tokens(rest)):
                if not t.startswith("/"):
                    self._del(lineno, t)
        elif verb in ("copy", "xcopy"):
            args = [t for t in self._drop_redirects(self._tokens(rest)) if not t.startswith("/")]
            if len(args) != 2:
                self.unsupported.append("line %d: %s" % (lineno, raw))
            else:
                self._copy(lineno, args[0], args[1])
        elif verb == "powershell":
            self._powershell(lineno, raw, line)
        else:
            self.unsupported.append("line %d: %s" % (lineno, raw))

    def _del(self, lineno, raw):
        target = self._path(raw)
        if not self._inside(target):
            self.failures.append("line %d: delete outside DLC refused (%s)" % (lineno, target))
            return
        if os.path.isdir(target):  # `del dir\` deletes the files directly inside it
            for n in os.listdir(target):
                p = os.path.join(target, n)
                if os.path.isfile(p) or os.path.islink(p):
                    os.unlink(p)
        elif os.path.lexists(target):
            os.unlink(target)

    def _copy(self, lineno, src_raw, dst_raw):
        src, dst = self._path(src_raw), self._path(dst_raw)
        if not os.path.isfile(src):
            self.failures.append("line %d: missing %s" % (lineno, os.path.relpath(src, self.sandbox)))
            return
        if os.path.isdir(dst) or dst_raw.strip('"').endswith(("\\", "/")):
            dst = os.path.join(dst, os.path.basename(src))
        if not self._inside(dst):
            self.failures.append("line %d: copy outside DLC refused (%s)" % (lineno, dst))
            return
        os.makedirs(os.path.dirname(dst), exist_ok=True)
        shutil.copyfile(src, dst)
        self.copied += 1

    def _powershell(self, lineno, raw, line):
        m = self.PS_REPLACE_RE.search(line)
        if not m or self.vars.get(m.group(1).lower()) is None:
            self.unsupported.append("line %d: %s" % (lineno, raw))
            return
        target = self._path(self.vars[m.group(1).lower()])
        if not os.path.isfile(target):
            return  # the script guards with File.Exists too
        if not self._inside(target):
            self.failures.append("line %d: write outside DLC refused" % lineno)
            return
        old, new = (s.replace("''", "'").encode("utf-8") for s in (m.group(2), m.group(3)))
        with open(target, "rb") as f:
            data = f.read()
        if old in data:
            with open(target, "wb") as f:
                f.write(data.replace(old, new))


def run_ui_check(label, folder, log):
    bat = ci_resolve(os.path.join(folder, "ui_check.bat"))
    if not os.path.isfile(bat):
        log(label + ": ui_check.bat not found in the mod folder, skipping.")
        return
    log(label + ": running ui_check.bat...")
    try:
        script = BatchScript(bat).run()
    except (InstallerError, OSError) as e:
        log("%s: ui_check.bat failed (%s)" % (label, e))
        return
    if script.unsupported or script.failures:
        log("%s: ui_check.bat finished with warnings (%d files copied):" % (label, script.copied))
        for line in (script.failures + ["unsupported " + u for u in script.unsupported])[:12]:
            log("  " + line)
    else:
        log("%s: ui_check.bat finished successfully (%d files)." % (label, script.copied))


def rerun_ui_checks(game, log):
    # EUI is shared by every mod -- re-run each installed mod's script so its
    # UI file picks follow the new EUI state (EuiWorker_DoWork).
    for mod in MODS:
        dirs = installed_folders(game, mod)
        if dirs:
            run_ui_check(mod.name, dirs[0], log)


def clear_civ_db_cache(game, log):
    """Civ V's cached gameplay DBs (top-level *.db only) -- rebuilt on launch.
    install-linux.sh always did this after installing."""
    if not game.docs:
        return 0
    cache = ci_resolve(os.path.join(game.docs, "cache"))
    n = 0
    try:
        for f in os.listdir(cache):
            p = os.path.join(cache, f)
            if f.lower().endswith(".db") and os.path.isfile(p):
                os.unlink(p)
                n += 1
    except OSError:
        return 0
    if n:
        log("Cleared Civ V's cached databases (%d files)." % n)
    return n


# ── Install / uninstall (InstallerCore.Run / Uninstall) ───────────────────────

def install_mod(game, mod, tag, want_beta, log, progress):
    progress(0)
    rel = mod.source.resolve(tag, want_beta)
    log("%s release: %s%s%s" % (mod.name, rel.tag, " (prerelease)" if rel.prerelease else "",
                                " [selected version]" if tag else ""))
    progress(10)
    folder = mod.folder_for(rel.tag)
    # Scratch space inside Assets (same filesystem, so the final move is a
    # rename) but outside Assets/DLC, so a half-extracted copy can never be
    # picked up by the game.
    scratch = tempfile.mkdtemp(prefix=".kekmod-install-", dir=game.assets)
    try:
        log("Downloading...")
        zp = mod.source.download(rel, scratch, log, lambda f: progress(10 + int(40 * f)))
        progress(50)
        log("Civ V DLC folder: " + game.dlc)
        target = ci_resolve(os.path.join(game.dlc, folder))
        if os.path.lexists(target):
            log("Removing existing " + os.path.basename(target) + "...")
            remove_tree(target)
        target = os.path.join(game.dlc, folder)
        progress(60)
        log("Extracting...")
        out = os.path.join(scratch, "x")
        extract_zip(zp, out)
        os.unlink(zp)
        tops = [os.path.join(out, n) for n in os.listdir(out) if os.path.isdir(os.path.join(out, n))]
        if mod.zip_prefix is None:
            if len(tops) != 1:
                raise InstallerError("Unexpected archive layout (top level: %s)." % ", ".join(os.listdir(out)))
            found = tops[0]
        else:
            found = None
            for dirpath, dirnames, _f in os.walk(out):
                hit = next((d for d in sorted(dirnames) if d.lower().startswith(mod.zip_prefix.lower())), None)
                if hit:
                    found = os.path.join(dirpath, hit)
                    break
            if found is None:
                raise InstallerError(mod.name + " folder not found in the downloaded archive.")
        os.rename(found, target)
    finally:
        shutil.rmtree(scratch, ignore_errors=True)
    progress(75)
    run_ui_check(mod.name, target, log)
    progress(90)
    # Other versions of THIS mod go only once the new one is in place.
    for d in installed_folders(game, mod):
        if os.path.basename(d).lower() != folder.lower():
            log("Removing old version " + os.path.basename(d) + "...")
            remove_tree(d)
    progress(95)
    if mod.extra:
        mod.extra.ensure(game, log)
    clear_civ_db_cache(game, log)
    progress(100)
    log("DONE: " + folder + " installed.")
    return folder


def uninstall_mod(game, mod, log, progress):
    progress(0)
    dirs = installed_folders(game, mod)
    if not dirs:
        log("Nothing to uninstall.")
    for i, d in enumerate(dirs):
        log("Removing " + os.path.basename(d) + "...")
        remove_tree(d)
        progress(10 + 80 * (i + 1) // len(dirs))
    if mod.extra:
        mod.extra.remove(game, log)
    clear_civ_db_cache(game, log)
    log("DONE: " + mod.name + " uninstalled.")
    progress(100)


# ── State + checks (MainForm.DetectInstalledState / RunAllChecks) ─────────────

class State:
    def __init__(self, game, releases, show_beta):
        self.installed = {}   # mod id -> [folder names]
        self.extras = {}      # extra id -> version label ("" if unknown); absent = not installed
        self.updates = {}     # mod id -> tag auto-install would pick now
        self.eui = None
        self.eui_match = None  # True / False / None (no bundled copy to compare against)
        self.lobby = None      # installed lobby patch tag ("" if unknown); None = not installed
        self.lobby_update = None  # newer lobby patch tag, if the release check found one
        if game is None or game.problem():
            return
        for mod in MODS:
            dirs = installed_folders(game, mod)
            if dirs:
                self.installed[mod.id] = [os.path.basename(d) for d in dirs]
                latest = latest_release(mod, releases.get(mod.id), show_beta)
                if latest and mod.folder_for(latest.tag).lower() != self.installed[mod.id][0].lower():
                    self.updates[mod.id] = latest.tag
            if mod.extra:
                v = mod.extra.detect(game)
                if v is not None:
                    self.extras[mod.extra.id] = v
        self.eui = eui_detect(game)
        if self.eui:
            self.eui_match = eui_exact_match(game, self.eui_variant())
        self.lobby = lobby_detect(game)
        # releases[LOBBY_REPO] is the latest tag string, not a release list.
        latest = releases.get(LOBBY_REPO)
        if self.lobby is not None and latest and latest.lower() != self.lobby.lower():
            self.lobby_update = latest

    def eui_variant(self):
        return next((v for v in EUI_VARIANTS if v.id == self.eui), None)

    def mod_version(self, mod):
        folders = self.installed.get(mod.id)
        return mod.version_of(folders[0]) if folders else None

    def installed_mods(self):
        return [m for m in MODS if m.id in self.installed]

    def missing_maps(self):
        return [m for m in self.installed_mods() if m.extra and m.extra.id not in self.extras]


def latest_release(mod, releases, show_beta):
    if not releases:
        return None
    if mod.beta_optin and not show_beta:
        return next((r for r in releases if not r.prerelease), None)
    return releases[0]


def run_checks(game, state):
    """[(ok, message)] -- the VERIFY MODS checks, plus the Proton build check."""
    out = []
    problem = game.problem() if game else "Civilization V wasn't found in any Steam library."
    out.append((problem is None, "Civ V is the Windows build (Proton)." if problem is None else problem))
    running = is_civ_running()
    out.append((not running, "Civilization V is currently running." if running else "Civilization V is not running."))
    inst = state.installed_mods()
    out.append((len(inst) < 2, " and ".join(m.name for m in inst) + " are both installed -- they can't run together."
                if len(inst) >= 2 else "No conflicting mods installed."))
    xits = state.eui == "eui_xits" and TOURNAMENT.id in state.installed
    out.append((not xits, "Tournament Mod and EUI XITS are installed together -- not compatible."
                if xits else "No Tournament Mod / EUI XITS conflict."))
    missing = state.missing_maps()
    out.append((not missing, "; ".join("%s is missing its %s" % (m.name, m.extra.name) for m in missing) + "."
                if missing else "No missing bonus maps."))
    v = state.eui_variant()
    if v is None:
        out.append((True, "No EUI variant installed."))
    elif state.eui_match is None:
        out.append((True, v.label() + " installed (bundled copy not available to compare)."))
    else:
        out.append((state.eui_match, v.label() + (" matches this installer's bundled copy exactly."
                                                   if state.eui_match else
                                                   " doesn't exactly match this installer's bundled copy.")))
    ups = [m.name for m in MODS if m.id in state.updates] + ([LOBBY_NAME] if state.lobby_update else [])
    out.append((not ups, "Update available for: " + ", ".join(ups) + "." if ups else "All installed mods are up to date."))
    return out


# ── Unrecognized folders (ExtraModScan.cs) ────────────────────────────────────

STOCK_DLC = {"expansion", "expansion2", "shared", "tablet"}


class ExtraFolder:
    def __init__(self, path, where):
        self.path, self.where = path, where
        self.name = os.path.basename(path)
        try:
            self.size = dir_size(path)
        except OSError:
            self.size = 0


def scan_extra_folders(game):
    found = []
    if game is None or not os.path.isdir(game.dlc):
        return found
    mod_prefixes = [m.folder_prefix.lower() for m in MODS]
    for name in sorted(os.listdir(game.dlc)):
        p = os.path.join(game.dlc, name)
        low = name.lower()
        if not os.path.isdir(p) or low.startswith(".kekmod-"):
            continue
        # Stock DLC is always "DLC*" (fail safe: never offer paid content for
        # deletion); "UI*" is EUI's namespace.
        if low.startswith(("dlc", "ui")) or low in STOCK_DLC or any(low.startswith(px) for px in mod_prefixes):
            continue
        found.append(ExtraFolder(p, "DLC"))
    if os.path.isdir(game.maps):
        for name in sorted(os.listdir(game.maps)):
            p = os.path.join(game.maps, name)
            if os.path.isdir(p) and name.lower() not in ("fish map script", "lekmap"):
                found.append(ExtraFolder(p, "Maps"))
    return found


def archive_folder(info):
    """Zips the folder in place (<name>.zip next to it, the folder as the zip's
    single top-level entry) and deletes it. A zip is never loaded by the game;
    extracting it back restores the folder. An existing same-named zip is
    kept, not overwritten."""
    zp = os.path.join(os.path.dirname(info.path), info.name + ".zip")
    if not os.path.exists(zp):
        tmp = zp + ".part"
        with zipfile.ZipFile(tmp, "w", zipfile.ZIP_DEFLATED) as zf:
            for dirpath, dirnames, files in os.walk(info.path):
                rel = os.path.relpath(dirpath, os.path.dirname(info.path))
                zf.write(dirpath, rel + "/")
                for f in files:
                    full = os.path.join(dirpath, f)
                    if not os.path.islink(full):
                        zf.write(full, os.path.join(rel, f))
        os.replace(tmp, zp)
    remove_tree(info.path)
    return zp


# ── Graphics caches (GraphicsCacheExtra.cs, Linux edition) ────────────────────
# Every target is a cache by contract -- the driver, DXVK or Steam rebuilds
# whatever is missing, so wiping is always safe. Locked/unreadable files are
# skipped and counted.

def gfx_cache_targets(game):
    """[(label, path, mode)]; mode is "all", "db" (top-level *.db only) or
    "dxvk" (top-level *.dxvk-cache only)."""
    xdg = os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache")
    flat = os.path.expanduser("~/.var/app/com.valvesoftware.Steam/cache")
    t = []
    if game:
        if game.steamapps:
            t.append(("Steam shader cache (Civ V)", os.path.join(game.steamapps, "shadercache", CIV_APPID), "all"))
        t.append(("DXVK state cache", game.root, "dxvk"))
        if game.prefix:
            local = os.path.join(game.prefix, "drive_c", "users", "steamuser", "AppData", "Local")
            for label, rel in (("D3D cache", "D3DSCache"), ("NVIDIA DX cache", "NVIDIA/DXCache"),
                               ("NVIDIA GL cache", "NVIDIA/GLCache"), ("NVIDIA NV_Cache", "NVIDIA Corporation/NV_Cache"),
                               ("AMD DX cache", "AMD/DxCache"), ("AMD DXC cache", "AMD/DxcCache"),
                               ("AMD GL cache", "AMD/GLCache"), ("AMD Vulkan cache", "AMD/VkCache"),
                               ("AMD OGL cache", "AMD/OglCache"), ("Intel shader cache", "Intel/ShaderCache")):
                t.append(("Proton " + label, os.path.join(local, rel), "all"))
        if game.docs:
            t.append(("Civ V game cache", ci_resolve(os.path.join(game.docs, "cache")), "db"))
    for base, suffix in ((xdg, ""), (flat, " (Flatpak Steam)")):
        t.append(("Mesa shader cache" + suffix, os.path.join(base, "mesa_shader_cache"), "all"))
        t.append(("Mesa shader cache DB" + suffix, os.path.join(base, "mesa_shader_cache_db"), "all"))
        t.append(("NVIDIA GL cache" + suffix, os.path.join(base, "nvidia", "GLCache"), "all"))
    t.append(("NVIDIA GL cache (legacy)", os.path.expanduser("~/.nv/GLCache"), "all"))
    return t


def clear_gfx_caches(game):
    """[(label, deleted, skipped)] for every target that exists."""
    results = []
    for label, path, mode in gfx_cache_targets(game):
        if not os.path.isdir(path) or os.path.islink(path):
            continue
        deleted = skipped = 0
        if mode == "all":
            files = []
            for dirpath, _d, names in os.walk(path):
                files += [os.path.join(dirpath, n) for n in names]
        else:
            ext = ".db" if mode == "db" else ".dxvk-cache"
            files = [os.path.join(path, n) for n in os.listdir(path)
                     if n.lower().endswith(ext) and os.path.isfile(os.path.join(path, n))]
        if mode == "dxvk" and not files:
            continue
        for f in files:
            try:
                os.unlink(f)
                deleted += 1
            except OSError:
                skipped += 1
        if mode == "all":  # empty subfolders only, never the root itself
            for dirpath, _d, _f in sorted(os.walk(path, topdown=False), key=lambda w: -len(w[0])):
                if dirpath != path:
                    try:
                        os.rmdir(dirpath)
                    except OSError:
                        pass
        results.append((label, deleted, skipped))
    return results


# ── Redownload (GameResetExtra.cs) ────────────────────────────────────────────

def validate_game_folder(game):
    """Full path to delete, or raises with the reason. Every check must pass:
    this is the only delete not confined to a folder we created."""
    if game is None or not os.path.isdir(game.root):
        raise InstallerError("Couldn't find a Civilization V install with Steam.")
    path = os.path.abspath(game.root)
    parent, grand = os.path.dirname(path), os.path.dirname(os.path.dirname(path))
    if (os.path.basename(path).lower() != CIV_FOLDER.lower() or os.path.basename(parent).lower() != "common"
            or os.path.basename(grand).lower() != "steamapps"):
        raise InstallerError('"%s" isn\'t a standard Steam game folder -- not deleting it.' % path)
    if os.path.islink(path):
        raise InstallerError('"%s" is a link to another folder -- not deleting it. Delete the game manually.' % path)
    if not any(os.path.isfile(os.path.join(path, n)) for n in ("CivilizationV.exe", "CivilizationV_DX11.exe")):
        raise InstallerError('"%s" has no CivilizationV.exe -- not deleting it.' % path)
    return path


def steam_tracks_game(path):
    steamapps = os.path.dirname(os.path.dirname(path))
    return os.path.isfile(os.path.join(steamapps, "appmanifest_%s.acf" % CIV_APPID))


def delete_game_folder(path, log, progress):
    """Deletes files, then folders deepest first. Symlinks are unlinked, never
    followed, so nothing outside the game folder can go with it. Returns
    (deleted, skipped, leftovers, folder_removed)."""
    log("Listing files in %s ..." % path)
    files, dirs = [], []
    for dirpath, dirnames, names in os.walk(path, followlinks=False):
        for d in dirnames:
            full = os.path.join(dirpath, d)
            (files if os.path.islink(full) else dirs).append(full)
        files += [os.path.join(dirpath, n) for n in names]
    log("%d files to delete." % len(files))
    deleted = skipped = 0
    leftovers = []
    last = -1
    for i, f in enumerate(files):
        try:
            os.unlink(f)
            deleted += 1
        except OSError:
            skipped += 1
            if len(leftovers) < 10:
                leftovers.append(f)
        pct = (i + 1) * 100 // max(1, len(files))
        if pct != last:
            progress(pct)
            last = pct
    for d in sorted(dirs, key=len, reverse=True):
        try:
            os.rmdir(d)
        except OSError:
            pass
    try:
        os.rmdir(path)
    except OSError:
        pass
    return deleted, skipped, leftovers, not os.path.exists(path)


def redownload_game(game, log, progress):
    path = validate_game_folder(game)
    tracked = steam_tracks_game(path)
    deleted, skipped, leftovers, removed = delete_game_folder(path, log, progress)
    log("%d files deleted%s." % (deleted, ", %d in use/skipped" % skipped if skipped else ""))
    for f in leftovers:
        log("  couldn't delete: " + f)
    n = sum(r[1] for r in clear_gfx_caches(game))
    log("Caches cleared (%d files)." % n)
    if not removed:
        log("Some files couldn't be deleted. Close Steam and anything open in the game folder, "
            "then run REDOWNLOAD CIV again.")
    url = "steam://%s/%s" % ("validate" if tracked else "install", CIV_APPID)
    log("Asking Steam to download the game again (%s)." % url)
    log("When the download finishes, set Proton for Civ V if needed, then reinstall your mods and EUI here.")
    if not open_in_desktop(url):
        log("Couldn't open Steam. In Steam: Civ V > Properties > Installed Files > Verify integrity of game files.")
    return removed


